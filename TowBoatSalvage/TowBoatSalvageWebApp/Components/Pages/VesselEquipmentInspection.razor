@page "/inspection"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TowBoatSalvageWebApp.Data
@using TowBoatSalvageWebApp.Models
@using TowBoatSalvageWebApp.Services
@using Microsoft.AspNetCore.Identity
@inject ISnackbar Snackbar
@inject SalvageDbContext db
@inject UserManager<ApplicationUser> UserManager
@inject VehicleInspectionService VehicleInspection
@attribute [Authorize]
<PageTitle>AMS Vessel Inspection</PageTitle>


<MudContainer MaxWidth="MaxWidth.False" Class="pa-0">

    <TowBoatSalvageWebApp.Components.Pages.NavBar.NavigationBar />

    <MudPaper Elevation="0" Square="true">
        <div class="header">
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="d-flex my-1">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Class="mx-5" />
                <MudText Typo="Typo.h5" Class="mx-0">AMS Vessel Equipment Inspection Checklist</MudText>
            </MudStack>
        </div>

        <div class="initial-inspection">
            <MudPaper Elevation="2" Class="my-1 pa-4 mx-1">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Class="fuel-log-select" Label="Select Boat" Variant="Variant.Outlined" @bind-Value="selectedBoat"
                        Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.DirectionsBoat"
                        OpenIcon="@Icons.Material.Filled.KeyboardArrowDown"
                        CloseIcon="@Icons.Material.Filled.KeyboardArrowUp" Required="true">
                        @foreach (var boat in boats)
                        {
                            <MudSelectItem Value="@boat">@boat</MudSelectItem>
                        }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="Crew Member" Variant="Variant.Outlined" @bind-Value="selectedCrew" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person" Required="true">
                        @foreach (var crew in crewMembers)
                        {
                            <MudSelectItem Value="@crew">@crew</MudSelectItem>
                        }
                    </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Date" Variant="Variant.Outlined" Class="my-1" @bind-Date="_dateOfInspection" />
                    </MudItem>
                </MudGrid>

                <div class="initial-inspection-questions">
                    <MudCheckBox @bind-Value="_floridaDOCCertificate" Label="Federal DOC Certificate or" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                    <MudCheckBox @bind-Value="_floridaRegistration" Label="Florida registration with 'FL' letters displayed" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                    <MudCheckBox @bind-Value="_currentRegistration" Label="Current registration/documentation in PVC tube" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                    <MudCheckBox @bind-Value="_alcoholTestStrip" Label="Alcohol test strip in PVC tube" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                    @if (_alcoholTestStrip)
                    {
                        <MudGrid Class="mx-5">
                            <MudItem xs="6" sm="3">
                                <MudDatePicker Label="Expiration Date" @bind-Date="_alcoholTestStripDate" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>
                        
                    }
                    <MudCheckBox @bind-Value="_vesselsLogBook" Label="Vessel's log book (fuel/maintenance) onboard vessel at all times" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                </div>
            </MudPaper>
        </div>
        <div class="safety-devices">
            <MudPaper Elevation="2" Class="my-3 pa-4 mx-1">
                <MudText Typo="Typo.h6" Class="">Captain's Personal Carry-on Items</MudText>
                <MudDivider DividerType="DividerType.Middle" Class="my-1" />

                <MudCheckBox @bind-Value="_captainsUSCGLicence" Label="Captain's USCG License" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                @if (_captainsUSCGLicence)
                {
                    <MudGrid Class="mx-5">
                        <MudItem xs="6" sm="3">
                            <MudDatePicker Label="Expiration Date" @bind-Date="_uSCGLicenseExpires" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                }
                <MudCheckBox @bind-Value="_proofOfDrugConsortium" Label="Proof of Drug Consortium Enrollment" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                @if (_proofOfDrugConsortium)
                {
                    <MudGrid Class="mx-5">
                        <MudItem xs="6" sm="3">
                            <MudDatePicker Label="Expiration Date" @bind-Date="_drugConsortiumExpires" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                }
                <MudCheckBox @bind-Value="_autoInflateLifeJacket" Label="Auto-inflate lifejacket" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                @if (_autoInflateLifeJacket)
                {
                    <MudGrid Class="mx-5">
                        <MudItem xs="6" sm="3">
                            <MudDatePicker Label="Expiration Date" @bind-Date="_autoInflateLifeJacketExpires" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                }
                <MudCheckBox @bind-Value="_captainsDitchBag" Label="Captain's Ditch Bag" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_pLBBatteryRegistration" Label="PLB (Battery & Registration)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                @if (_pLBBatteryRegistration)
                {
                    <MudGrid Class="mx-5">
                        <MudItem xs="6" sm="3">
                            <MudDatePicker Label="Expiration Date" @bind-Date="_pLBExpires" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                }
                <MudCheckBox @bind-Value="_clipboardsWithInvoices" Label="Clipboard with invoices, salvage contracts, ungrounding R.O.L" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_uSCGRulesOfTheRoadBook" Label="USCG Rules of the Road Book" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
            </MudPaper>
        </div>

        <div class="captains-personal-carry-on-items">
            <MudPaper Elevation="2" Class="my-3 pa-4 mx-1">
                <MudText Typo="Typo.h6" Class="">Safety Devices</MudText>
                <MudDivider DividerType="DividerType.Middle" Class="my-1" />

                <MudCheckBox @bind-Value="_captainCrewType1Offshore" Label="Captain/Crew - Type 1 offshore (One oneboard)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_adultPFDs" Label="Adult - Type III PFD'S (or type 1)(four onboard)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_childsPFDs" Label="Childs - Type III PFD'S (two onboard)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_throwableLifeRing" Label="Throwable (life ring/float cushion) - one minimum on board" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_coldWaterSuite" Label="Cold water immersion suit" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_flares" Label="Pyro/Flares: 3 'Day' & 'Night'" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                @if (_flares)
                {
                    <MudGrid Class="mx-5">
                        <MudItem xs="6" sm="3">
                            <MudDatePicker Label="Expiration Date" @bind-Date="_flaresExpire" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                }
                <MudCheckBox @bind-Value="_epirb" Label="406 EPIRB (Battery & Registration)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                @if (_epirb)
                {
                    <MudGrid Class="mx-5">
                        <MudItem xs="6" sm="3">
                            <MudDatePicker Label="Expiration Date" @bind-Date="_epirbExpires" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                }
                <MudCheckBox @bind-Value="_fireExtinguishers" Label="Fire Extinguishers - two small, one 5LB mounted (inspect)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_firstAidKit" Label="First Aid Kit 5, Person" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_thermalBlanket" Label="Thermal Blanket (foil type)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_handheldVHF" Label="Handheld VHF" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
            </MudPaper>
        </div>

        <div class="mounted-lights-signals">
            <MudPaper Elevation="2" Class="my-3 pa-4 mx-1">
                <MudText Typo="Typo.h6" Class="">Mounted Lights and Signals</MudText>
                <MudDivider DividerType="DividerType.Middle" Class="my-1" />

                <MudCheckBox @bind-Value="_navigation" Label="Navigation" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_towing" Label="Towing (yellow over white)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_publicSafety" Label="Public Safety (red, amber, white strobes)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_spotLight" Label="Spot Light" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_deckFlood" Label="Deck flood/cockpit lights" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_flashlight" Label="Flashlight" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_horn" Label="Horn/sound producing device" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_siren" Label="Siren" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_fogHorn" Label="Fog Horn" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_hailer" Label="Hailer" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
            </MudPaper>
        </div>

        <div class="placards">
            <MudPaper Elevation="2" Class="my-3 pa-4 mx-1">
                <MudText Typo="Typo.h6" Class="">Placards</MudText>
                <MudDivider DividerType="DividerType.Middle" Class="my-1" />

                <MudCheckBox @bind-Value="_dischargeOfOil" Label="Discharge of Oil Placard" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_dischargeOfGarbage" Label="Discharge of Garbage Placard" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_navigationChart" Label="Navigation Chart, electronic or paper" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_boatUSMembershipApplications" Label="BoatU.S. Membership Applications" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
            </MudPaper>
        </div>

        <div class="navigation-communication-electronics">
            <MudPaper Elevation="2" Class="my-3 pa-4 mx-1">
                <MudText Typo="Typo.h6" Class="">Navigation, Communication & Electronics</MudText>
                <MudDivider DividerType="DividerType.Middle" Class="my-1" />

                <MudCheckBox @bind-Value="_gPS" Label="GPS with Electronic navigtation charts" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_backupGPS" Label="Backup GPS" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_depthFinder" Label="Depth Finder" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_radar" Label="Radar" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_vHFPrimary" Label="VHF Primary w/MMSI/GPS" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_vHFSecondary" Label="VHF Secondary" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_dVR" Label="DVR system operational" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_checkDVRCardForRecording" Label="Check DVR Card for recording on pc" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                @if (_checkDVRCardForRecording)
                {
                    <MudGrid Class="mx-5">
                        <MudItem xs="6" sm="3">
                            <MudDatePicker Label="First Recording" @bind-Date="_firstRecording" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                    <MudGrid Class="mx-5">
                        <MudItem xs="6" sm="3">
                            <MudDatePicker Label="Last Recording" @bind-Date="_lastRecording" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>

                }
                <MudCheckBox @bind-Value="_whiskeyOrELectronicCompass" Label="Whiskey or Electronic Compass" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_binoculars" Label="Binoculars" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
            </MudPaper>
        </div>

        <div class="vessels-equipment">
            <MudPaper Elevation="2" Class="my-3 pa-4 mx-1">
                <MudText Typo="Typo.h6" Class="">Vessel's Equipment</MudText>
                <MudDivider DividerType="DividerType.Middle" Class="my-1" />

                <MudCheckBox @bind-Value="_towBit" Label="Tow Bit - Inspect no cracks, bolts tight" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_knife" Label="Knife mounted on tow-post for quick access" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_primaryTowLine" Label="Primary Tow Line - min 400' of 3/4' three strand Poly Pro (inspect)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_secondaryTowLine" Label="Secondary Tow Line - min of 200' of 3/4' three strand Poly Pro (inspect)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_fendersTwo8" Label="Fenders Two 8' (Min cylinders min two round all purpose 20' diameter" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_spareBattery" Label="Spare Battery" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_jumperCables" Label="Jumper Cables" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_twoBilgePumps" Label="Two operational 2000 GPH bilge pumps installed (works on manual & auto)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_primaryAnchor" Label="Primary anchor with min 150' rode+chain+anchor" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_backupAnchor" Label="Backup anchor with min 100' rode+anchor" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_boatHook" Label="Boat Hook" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_toolKit" Label="Tool kit - to include fuel filter wrench" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_twoGasolineCans" Label="Two five/six gallon gasolione cans" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_twoFuelFilters" Label="Two water-separating fuel filters (un-opened spares)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
            </MudPaper>
        </div>

        <div class="salvage-damage-control-gear">
            <MudPaper Elevation="2" Class="my-3 pa-4 mx-1">
                <MudText Typo="Typo.h6" Class="">Salvage / Damage Control Gear</MudText>
                <MudDivider DividerType="DividerType.Middle" Class="my-1" />

                <MudCheckBox @bind-Value="_twoRulePumps" Label="Two 3700 GPH Rule DC pumps" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_bucket" Label="One 3-to-5-gallon bucket w/ sponge" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_pump" Label="One 2' engine driven pump" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_pVCPipe" Label="Discharge PVC pipe (for 2' gas pump)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_suctionHose" Label="Suction hose (for 2' gas pump)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_pads" Label="Oil absorbent pads (15 to 20)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_woodenPlugs" Label="Damage Control - woode plugs (assorted sizes)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_foamFootballs" Label="Damage Control - foam footballs/foam chunks" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
            </MudPaper>
        </div>

        <div class="Oil-fluids">
            <MudPaper Elevation="2" Class="my-3 pa-4 mx-1">
                <MudText Typo="Typo.h6" Class="">Oil and Fluids</MudText>
                <MudDivider DividerType="DividerType.Middle" Class="my-1" />

                <MudCheckBox @bind-Value="_twoStrokOil" Label="One gallon two-stroke oil (for sale)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_fourCycleOil" Label="One quart four-cycle oil (for sale)" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
            </MudPaper>
        </div>

        <div class="operational-check-salvage-pump">
            <MudPaper Elevation="2" Class="my-3 pa-4 mx-1">
                <MudText Typo="Typo.h6" Class="">Operational Check of Salvage Pump</MudText>
                <MudDivider DividerType="DividerType.Middle" Class="my-1" />

                <MudCheckBox @bind-Value="_salvagePump" Label="Run salvage pump dockside with suction and discharge hoses attached, establish a pumping condition" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_servicePump" Label="Service pump by rinsing out and draining pump housing" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_emptyFuelCarburator" Label="Empty the fuel/carburetor bowl by running until empty" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_fillGasTank" Label="Fill gas tank with non-ethanol fuel" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_inspectWiring" Label="Inspect wiring of 3700 GPH Rule DC Pumps" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudCheckBox @bind-Value="_verifyPumpRuns" Label="Verify 3700 Rule pumps run, sinpect wiring for excess heat" Color="Color.Primary" UncheckedColor="Color.Default"></MudCheckBox>
                <MudGrid Class="mx-5">
                    <MudItem xs="6" sm="3">
                        <MudDatePicker Label="Date" @bind-Date="_dateOfPumpCheck" Variant="Variant.Outlined" />
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </div>

        <div class="submit">
            <MudPaper Elevation="0" Class=" d-flex justify-center my-2">
                <MudButton OnClick="OnSubmitAsync" ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">Submit Inspection</MudButton>
            </MudPaper>
        </div>
    </MudPaper>
</MudContainer>

@code {
    private string? selectedBoat;
    private string? selectedCrew;
    private readonly List<string> boats = new()
    {
        "Towboat 1",
        "Towboat 2",
        "Towboat 3",
        "Towboat 4",
        "Towboat 5",
        "Towboat 6",
        "Towboat 7",
        "Towboat 8",
        "Towboat 9",
        "Towboat 10",
        "Towboat 11",
        "Towboat 12",
        "Towboat 14",
        "Towboat 16",
    };

    private readonly List<string> crewMembers = new();

    private string _vesselNumber = string.Empty;
    public string _employeeOrCaptain = string.Empty;
    private DateTime? _dateOfInspection = DateTime.Now;

    //initial inspection
    public bool _floridaDOCCertificate;
    public bool _floridaRegistration;
    public bool _currentRegistration;
    public bool _alcoholTestStrip;
    public DateTime? _alcoholTestStripDate;
    public bool _vesselsLogBook;

    //captains personal items
    public bool _captainsUSCGLicence;
    public DateTime? _uSCGLicenseExpires;
    public bool _proofOfDrugConsortium;
    public DateTime? _drugConsortiumExpires;
    public bool _autoInflateLifeJacket;
    public DateTime? _autoInflateLifeJacketExpires;
    public bool _captainsDitchBag;
    public bool _pLBBatteryRegistration;
    public DateTime? _pLBExpires;
    public bool _clipboardsWithInvoices;
    public bool _uSCGRulesOfTheRoadBook;

    //safety devices
    public bool _captainCrewType1Offshore;
    public bool _adultPFDs;
    public bool _childsPFDs;
    public bool _throwableLifeRing;
    public bool _coldWaterSuite;
    public bool _flares;
    public DateTime? _flaresExpire;
    public bool _epirb;
    public DateTime? _epirbExpires;
    public bool _fireExtinguishers;
    public bool _firstAidKit;
    public bool _thermalBlanket;
    public bool _handheldVHF;

    //mounted lights
    public bool _navigation;
    public bool _towing;
    public bool _publicSafety;
    public bool _spotLight;
    public bool _deckFlood;
    public bool _flashlight;
    public bool _horn;
    public bool _siren;
    public bool _fogHorn;
    public bool _hailer;

    //placards
    public bool _dischargeOfOil;
    public bool _dischargeOfGarbage;
    public bool _navigationChart;
    public bool _boatUSMembershipApplications;

    //navigation
    public bool _gPS;
    public bool _backupGPS;
    public bool _depthFinder;
    public bool _radar;
    public bool _vHFPrimary;
    public bool _vHFSecondary;
    public bool _dVR;
    public bool _checkDVRCardForRecording;
    public DateTime? _firstRecording;
    public DateTime? _lastRecording;
    public bool _whiskeyOrELectronicCompass;
    public bool _binoculars;

    //vessel equipment
    public bool _towBit;
    public bool _knife;
    public bool _primaryTowLine;
    public bool _secondaryTowLine;
    public bool _fourDockLines;
    public bool _fendersTwo8;
    public bool _spareBattery;
    public bool _jumperCables;
    public bool _twoBilgePumps;
    public bool _primaryAnchor;
    public bool _backupAnchor;
    public bool _boatHook;
    public bool _toolKit;
    public bool _twoGasolineCans;
    public bool _twoFuelFilters;

    //salvage
    public bool _twoRulePumps;
    public bool _bucket;
    public bool _pump;
    public bool _pVCPipe;
    public bool _suctionHose;
    public bool _pads;
    public bool _woodenPlugs;
    public bool _foamFootballs;

    //oil
    public bool _twoStrokOil;
    public bool _fourCycleOil;

    //operational check
    public bool _salvagePump;
    public bool _servicePump;
    public bool _emptyFuelCarburator;
    public bool _fillGasTank;
    public bool _inspectWiring;
    public bool _verifyPumpRuns;
    public DateTime? _dateOfPumpCheck;

    protected override async Task OnInitializedAsync()
    {
        await CreateFuelList();
    }

    private async Task CreateFuelList()
    {
        var users = await UserManager.Users.OrderBy(u => u.Email).ToListAsync();

        foreach (var user in users)
        {
            crewMembers.Add(user.Name);
        }
    }

    private async Task OnSubmitAsync()
    {
        try
        {

            var inspection = new VehicleInspection
            {
                VesselNumber = selectedBoat!,
                EmployeeOrCaptain = selectedCrew!,
                DateOfInspection = _dateOfInspection
            };

            inspection.InitialInspection.FloridaDOCCertificate = _floridaDOCCertificate;
            inspection.InitialInspection.FloridaRegistration = _floridaRegistration;
            inspection.InitialInspection.CurrentRegistration = _currentRegistration;
            inspection.InitialInspection.AlcoholTestStrip = _alcoholTestStrip;
            inspection.InitialInspection.AlcoholTestStripDate = _alcoholTestStripDate;
            inspection.InitialInspection.VesselsLogBook = _vesselsLogBook;

            inspection.CaptainsPersonalItems.CaptainsUSCGLicence = _captainsUSCGLicence;
