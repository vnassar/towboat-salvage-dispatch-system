    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || hubStarted || hubConnection is null) return;

        hubStarted = true;

        try
        {
            await hubConnection.StartAsync();
            _salvageHubConnectionId = hubConnection.ConnectionId;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"SignalR start failed: {ex}");
            Console.WriteLine($"**********SalvageBoard.razor: SignalR start failed: {ex}");
        }
    }

