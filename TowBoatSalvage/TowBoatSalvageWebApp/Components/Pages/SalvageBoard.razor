    private void OpenPhotosFromCard(SalvageRow row)
    {
        var imgCol = Columns.FirstOrDefault(c =>
            string.Equals(c.Type, "FileUpload", StringComparison.OrdinalIgnoreCase));

        if (imgCol == null) return;

        var cell = row.Cells.FirstOrDefault(c => c.ColumnId == imgCol.Id);
        var files = cell?.Files?.ToList() ?? new List<SalvageFile>();
        if (files.Count == 0)
        {
            _ = ToastService.ShowToast("No photo found for this dispatch.", "error");
            return;
        }

        OpenGallery(files, files[0].FileName);
    }

    private void OpenNotesFromCard(SalvageRow row)
    {
        var notesCol = Columns.FirstOrDefault(c => c.Label == "Notes");
        if (notesCol is null)
        {
            Console.WriteLine("notesCol is null!");
            return;
        }
        

        OpenLongTextModal(row, notesCol);
    }




