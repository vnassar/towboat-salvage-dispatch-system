    private async Task<IEnumerable<SalvageRow>> GetFilteredCompletedRowsAsync()
    {
        var now = DateTime.Now;

        //get only completed rows
        IEnumerable<SalvageRow> rows = Rows.Where(r =>
        {
            var statusCell = r.Cells.FirstOrDefault(cell => cell.ColumnId == StatusCol?.Id);
            return statusCell != null && statusCell.Value == "Completed";
        });



        //filter by date range
        if (CompletedDateCol != null && completedFilter != "all")
        {
            Func<DateTime, bool> dateFilter = _ => true;
            switch (completedFilter)
            {
                case "30days":
                    dateFilter = d => d >= now.AddDays(-30);
                    break;
                case "60days":
                    dateFilter = d => d >= now.AddDays(-60);
                    break;
                case "90days":
                    dateFilter = d => d >= now.AddDays(-90);
                    break;
                case "thisYear":
                    dateFilter = d => d.Year >= now.Year;
                    break;
                case "lastYear":
                    dateFilter = d => d.Year >= now.Year - 1;
                    break;
            }

            rows = rows.Where(r =>
            {
                var dateCell = r.Cells.FirstOrDefault(cell => cell.ColumnId == CompletedDateCol.Id);
                return dateCell != null &&
                        DateTime.TryParse(dateCell.Value, out var dateVal) &&
                        dateFilter(dateVal);
            });
        }

        //filter by search 
        if (!string.IsNullOrWhiteSpace(completedSearch))
        {
            var search = completedSearch.Trim().ToLowerInvariant();
            rows = rows.Where(r =>
                r.Cells.Any(cell => !string.IsNullOrWhiteSpace(cell.Value) && cell.Value.ToLower().Contains(search)));
        }

        // order by most recent completed date
        if (CompletedDateCol != null)
        {
            rows = rows.OrderByDescending(r =>
            {
                var datecell = r.Cells.FirstOrDefault(cell => cell.ColumnId == CompletedDateCol.Id);
                if (datecell != null && DateTime.TryParse(datecell.Value, out var dateVal)) return dateVal;
                return DateTime.MinValue;
            });
        }

        return rows;
    }

