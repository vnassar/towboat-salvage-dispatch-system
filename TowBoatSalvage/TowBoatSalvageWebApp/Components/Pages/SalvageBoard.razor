    private List<TowBoatCaptains> Captains = new();

    private void HighlightRow(int rowId)
    {
        if (highlightTokens.TryGetValue(rowId, out var existing))
        {
            existing.Cancel();
            existing.Dispose();
        }

        var cts = new CancellationTokenSource();
        highlightTokens[rowId] = cts;

        highlightedRows.Add(rowId);
        _ = ClearHighlightAfterDelayAsync(rowId, cts.Token);
    }

    private async Task ClearHighlightAfterDelayAsync(int rowId, CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        highlightedRows.Remove(rowId);
        highlightTokens.Remove(rowId);
        await InvokeAsync(StateHasChanged);
    }

    private void OnColumnDragStart(int colId)
    {
        draggingColumnId = colId;
    }

    private void OnColumnDragOver(int colId)
    {
        dragOverColumnId = colId;
    }

    private void OnColumnDragEnd()
    {
        draggingColumnId = null;
        dragOverColumnId = null;
    }

    private async Task OnColumnDrop(int targetColId)
    {
        if (draggingColumnId is null || draggingColumnId == targetColId)
        {
            dragOverColumnId = null;
            return;
        }

        var fromIndex = Columns.FindIndex(c => c.Id == draggingColumnId.Value);
        var toIndex = Columns.FindIndex(c => c.Id == targetColId);

        if (fromIndex < 0 || toIndex < 0)
        {
            draggingColumnId = null;
            dragOverColumnId = null;
            return;
        }

        var moved = Columns[fromIndex];
        Columns.RemoveAt(fromIndex);
        Columns.Insert(toIndex, moved);

        await TableService.UpdateColumnOrderAsync(Columns.Select(c => c.Id).ToList());

        draggingColumnId = null;
        dragOverColumnId = null;

        await LoadBoardAsync();
    }

