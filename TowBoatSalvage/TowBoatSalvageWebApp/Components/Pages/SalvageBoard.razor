    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        completedSearch = e.Value?.ToString() ?? "";
        FilteredCompletedRows = (await GetFilteredCompletedRowsAsync()).ToList();
        StateHasChanged();
    }

    private async Task OnCompletedFilterChnaged(ChangeEventArgs e)
    {
        completedFilter = e.Value?.ToString() ?? "all";
        FilteredCompletedRows = (await GetFilteredCompletedRowsAsync()).ToList();
        StateHasChanged();
