        <div class="salvage-board">
            <div class="table-menu">
                <div class="table-menu-left">
                    <h1>Active</h1>
                    <button class="btn btn-primary mb-3 hide-on-mobile" @onclick="ShowAddColumnModal">+ Add Column</button>
                </div>


                <MudFab Class="hide-on-mobile" title="settings" StartIcon="@Icons.Material.Filled.Settings" Size="Size.Small" OnClick="NavToSalvageSettings" />
            </div>

            <!-- Wrap table in a scrollable container, this before was shrinking and getting to tight/bad UI-->
            <div class="table-scroll-container">
                @*ACTIVE ROW TABLE*@
                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr class="table-header-desktop">
                                <th class="row-menu-cell sticky-col first-col">
                                    <!--leaving blank for action column-->
                                    <p> </p>
                                </th>
                                @{
                                    int colIndex = 0;
                                }
                                @foreach (var col in Columns)
                                {
                                    if (col.Label == "G# OR Company")
                                    {
                                        <th class="row-menu-cell sticky-col second-col">
                                            <div class="d-flex justify-content-between align-items-center w-100">
                                                <div>
                                                    @col.Label
                                                </div>
                                                <!--Three-dot icon -->
                                                <button class="menu-btn" @onclick="e => ShowColumnMenu(col.Id, e)" @ref="@columnMenuButtonRefs[col.Id]" @onclick:stopPropagation>
                                                    &#8942;
                                                </button>
                                            </div>
                                        </th>
                                    }
