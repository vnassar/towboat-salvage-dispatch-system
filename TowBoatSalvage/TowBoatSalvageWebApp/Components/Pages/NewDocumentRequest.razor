    private async Task LoadDocumentsAsync()
    {
        var admin = isAdmin();

        if (admin)
        {
            isUserAdmin = true;
            //loading without filtering, show all documents
            _sentRequest = await Db.DocumentSignatureRequests
            .Include(x => x.CreditCard) //load related
            .OrderByDescending(x => x.SentAtUtc)
            .ToListAsync();
        }
        else
        {
            //otherwise filter by captain. captain will have a role NOT admin, i.e, Captain
            _sentRequest = await Db.DocumentSignatureRequests
            .Include(x => x.CreditCard) //load related
            .Where(x => x.CaptainEmail == _captainEmail)
            .OrderByDescending(x => x.SentAtUtc)
            .ToListAsync();
        }

        var count = _sentRequest.Count();

    }

    private void OnSelectedFormChanged()
    {
        _salvageStep = 0;
    }

    private void NextSalvageStep()
    {
        if (_salvageStep == 0 && !CanMoveToVesselStep())
        {
            Snackbar.Add("Complete contact details before continuing.", Severity.Warning);
            return;
        }

        if (_salvageStep == 1 && !CanMoveToReviewStep())
        {
            Snackbar.Add("Complete vessel and service details before continuing.", Severity.Warning);
            return;
        }

        _salvageStep = Math.Min(_salvageStep + 1, 2);
    }

    private void PrevSalvageStep()
    {
        _salvageStep = Math.Max(_salvageStep - 1, 0);
    }

    private bool CanMoveToVesselStep() =>
        !string.IsNullOrWhiteSpace(_customerName) &&
        !string.IsNullOrWhiteSpace(_customerEmail) &&
        !string.IsNullOrWhiteSpace(_gps) &&
        !string.IsNullOrWhiteSpace(_customerAddress);

    private bool CanMoveToReviewStep() =>
        !string.IsNullOrWhiteSpace(_vesselLength) &&
        !string.IsNullOrWhiteSpace(_vesselMake) &&
        !string.IsNullOrWhiteSpace(_underwriter) &&
        !string.IsNullOrWhiteSpace(_delivery) &&
        !string.IsNullOrWhiteSpace(_quote) && 
        _selectedPricingModel is not null;

    private bool isAdmin()
    {
        if (UserState is not null)
        {
            var isUserAdmin = UserState.Roles!.Contains("Admin");
            if (isUserAdmin)
            {
                return true;
            }
        }
        return false;
    }

