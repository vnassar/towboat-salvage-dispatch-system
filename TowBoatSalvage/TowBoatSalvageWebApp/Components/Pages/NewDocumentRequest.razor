    private string GetEmailStatusLabel(DocumentSignatureRequest request)
    {
        if (request.EmailFailedAtUtc is not null) return "Email Failed";
        if (request.EmailOpenedAtUtc is not null) return "Opened";
        if (request.EmailDeliveredAtUtc is not null) return "Delivered";
        if (request.EmailAcceptedAtUtc is not null) return "Accepted";
        return "Queued";
    }

    private Color GetEmailStatusColor(DocumentSignatureRequest request)
    {
        if (request.EmailFailedAtUtc is not null) return Color.Error;
        if (request.EmailOpenedAtUtc is not null) return Color.Success;
        if (request.EmailDeliveredAtUtc is not null) return Color.Info;
        if (request.EmailAcceptedAtUtc is not null) return Color.Primary;
        return Color.Warning;
    }

    private string? GetEmailStatusDetail(DocumentSignatureRequest request)
    {
        if (request.EmailFailedAtUtc is not null)
        {
            var failedAt = request.EmailFailedAtUtc.Value.ToLocalTime().ToString("g");
            return string.IsNullOrWhiteSpace(request.EmailFailureReason)
                ? $"Failed at {failedAt}"
                : $"Failed at {failedAt}: {request.EmailFailureReason}";
        }

        if (request.EmailOpenedAtUtc is not null)
        {
            return $"Opened at {request.EmailOpenedAtUtc.Value.ToLocalTime():g}";
        }

        if (request.EmailDeliveredAtUtc is not null)
        {
            return $"Delivered at {request.EmailDeliveredAtUtc.Value.ToLocalTime():g}";
        }

        if (request.EmailAcceptedAtUtc is not null)
        {
            return $"Accepted by Mailgun at {request.EmailAcceptedAtUtc.Value.ToLocalTime():g}";
        }

        return null;
    }

