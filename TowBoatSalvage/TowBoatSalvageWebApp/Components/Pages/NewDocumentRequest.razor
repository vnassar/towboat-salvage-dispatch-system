    private async Task ViewSignedDocument(DocumentSignatureRequest request)
    {
        if (request.SignedPdf is null || request.SignedPdf.Length == 0)
        {
            Snackbar.Add("No signed PDF available.", Severity.Error);
            return;
        }

        var base64 = Convert.ToBase64String(request.SignedPdf);
        await JS.InvokeVoidAsync("pdfViewer.openPdfInNewTab", base64);
    }

