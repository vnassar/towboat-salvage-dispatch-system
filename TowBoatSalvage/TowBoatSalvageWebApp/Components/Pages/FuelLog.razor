@inject ISnackbar Snackbar
@inject FuelLogService FuelLogService
@inject UserManager<ApplicationUser> UserManager
@using Microsoft.EntityFrameworkCore
@page "/fuel-log"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using TowBoatSalvageWebApp.Data
@using TowBoatSalvageWebApp.Services

@attribute [Authorize]

<PageTitle>Fuel Log</PageTitle>
<link href="~/fuel-log.css" rel="stylesheet" />


<MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
    <TowBoatSalvageWebApp.Components.Pages.NavBar.NavigationBar />

    <MudPaper Elevation="6" Class="fuel-log-card">
        <MudStack Spacing="3">
            <MudStack Direction="Row" AlignItems="AlignItems.Center" Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6">New Fuel Log</MudText>
                </MudStack>
            </MudStack>

            <MudDivider />

            <MudSelect T="string" Class="fuel-log-select" Label="Select Boat *" Variant="Variant.Outlined" @bind-Value="selectedBoat"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.DirectionsBoat"
                OpenIcon="@Icons.Material.Filled.KeyboardArrowDown"
                CloseIcon="@Icons.Material.Filled.KeyboardArrowUp">
                @foreach (var boat in boats)
                {
                    <MudSelectItem Value="@boat">@boat</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker Label="Date *" Variant="Variant.Outlined" @bind-Date="logDate" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />

            <MudDivider DividerType="DividerType.Middle"/>

            <MudText Typo="Typo.overline" Class="fuel-log-section">Engine Hours</MudText>

            <MudNumericField T="decimal?" Variant="Variant.Outlined" Label="Current Engine 1 Hours" @bind-Value="engine1Hours" Adornment="Adornment.End" AdornmentText="hrs"/>

            <MudNumericField T="decimal?" Variant="Variant.Outlined" Label="Current Engine 2 Hours" @bind-Value="engine2Hours" Adornment="Adornment.End" AdornmentText="hrs"/>
            <MudDivider DividerType="DividerType.Middle" />

            <MudText Typo="Typo.overline" Class="fuel-log-section">Fuel Added (Gallons)</MudText>

            <MudNumericField T="decimal?" Variant="Variant.Outlined" Label="Fuel Added - Engine 1" @bind-Value="fuel1" Adornment="Adornment.End" AdornmentText="gal" />

            <MudNumericField T="decimal?" Variant="Variant.Outlined" Label="Fuel Added - Engine 2" @bind-Value="fuel2" Adornment="Adornment.End" AdornmentText="gal" />

            <MudPaper Class="fuel-log-summary">
                <MudStack Direction="Row" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2">Total Fuel Added:</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fuel-log-accent">@combinedFuel.ToString("0.0") gal</MudText>
                </MudStack>
            </MudPaper>

            <MudDivider DividerType="DividerType.Middle" />

            <MudText Typo="Typo.overline" Class="fuel-log-section">Fuel Added - Gas Cans (Gallons)</MudText>

            <MudNumericField T="decimal?" Variant="Variant.Outlined" Label="Fuel Added - Gans Cans (Optional)" @bind-Value="GasCans" Adornment="Adornment.End" AdornmentText="gal" />

            <MudDivider DividerType="DividerType.Middle" />

            <MudText Typo="Typo.overline" Class="fuel-log-section">Crew</MudText>

            <MudSelect T="string" Label="Crew Member Fueling Boat *" Variant="Variant.Outlined" @bind-Value="selectedCrew" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person">
                @foreach (var crew in crewMembers)
                {
                    <MudSelectItem Value="@crew">@crew</MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" Class="fuel-log-submit" @onclick="SaveButton">Submit Fuel Entry</MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>
<br/>

@code {
    private string? selectedBoat;
    private string? selectedCrew;
    private DateTime? logDate = DateTime.Today;
    private decimal? engine1Hours;
    private decimal? engine2Hours;
    private decimal combinedEngineHours => (engine1Hours ?? 0m) + (engine2Hours ?? 0m);
    private decimal? fuel1;
    private decimal? fuel2;
    private decimal? GasCans;
    private decimal combinedFuel => (fuel1 ?? 0m) + (fuel2 ?? 0m);


    private static readonly Dictionary<string, object> DecimalInputAttributes = new()
    {
        ["type"] = "text",
        ["inputmode"] = "decimal",
        ["pattern"] = "[0-9]*[.,]?[0-9]*"
    };


    private readonly List<string> boats = new()
    {
        "Towboat 1",
        "Towboat 2",
        "Towboat 3",
        "Towboat 4",
        "Towboat 5",
        "Towboat 6",
        "Towboat 7",
        "Towboat 8",
        "Towboat 9",
        "Towboat 10",
        "Towboat 11",
        "Towboat 12",
        "Towboat 14",
        "Towboat 16",
    };

    private readonly List<string> crewMembers = new();

    protected override async Task OnInitializedAsync()
    {
        await CreateFuelList();
    }

    private async Task CreateFuelList()
    {
        var users = await UserManager.Users.OrderBy(u => u.Email).ToListAsync();

        foreach (var user in users)
        {
            if (user.AddToFuelList == true)
            {
                crewMembers.Add(user.Name);
            }
        }
    }
    private async Task SaveButton()
    {
        if (string.IsNullOrWhiteSpace(selectedBoat) || string.IsNullOrWhiteSpace(selectedCrew) || logDate is null)
        {
            Snackbar.Add("Please complete all required fields.", Severity.Warning);
            return;
        }

        var entry = new FuelLogEntry
        {
            BoatName = selectedBoat,
            CrewMember = selectedCrew,
            LogDate = logDate.Value,
            Engine1Hours = engine1Hours ?? 0m,
            Engine2Hours = engine2Hours ?? 0m,
            Fuel1 = fuel1 ?? 0m,
            Fuel2 = fuel2 ?? 0m,
            GasCans = GasCans ?? 0m
        };

        await FuelLogService.AddAsync(entry);

        Snackbar.Add("Fuel log saved.", Severity.Success);

        engine1Hours = null;
        engine2Hours = null;
        fuel1 = null;
        fuel2 = null;
        GasCans = null;
        selectedBoat = null;
        selectedCrew = null;

    }


}
