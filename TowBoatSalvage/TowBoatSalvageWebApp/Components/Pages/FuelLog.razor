@inject ISnackbar Snackbar
@inject FuelLogService FuelLogService
@inject UserManager<ApplicationUser> UserManager
@inject UserService UserService
@using Microsoft.EntityFrameworkCore
@page "/fuel-log"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using TowBoatSalvageWebApp.Data
@using TowBoatSalvageWebApp.Services

@attribute [Authorize]

<PageTitle>New Fuel Log</PageTitle>
<link href="~/fuel-log.css" rel="stylesheet" />


<MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
    <TowBoatSalvageWebApp.Components.Pages.NavBar.NavigationBar />

    <MudPaper Elevation="0" Square="true" Class="maintenance-shell mx-auto">
        <!-- Header -->
        <MudPaper Elevation="0" Square="true" Class="maintenance-header px-4 pt-6 pb-2">
            <div class="header-title">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Class="mr-2" />
                <MudText Typo="Typo.h5" Class="header-title-text">Fleet Maintenance</MudText>
            </div>
        </MudPaper>

        <MudPaper Elevation="2" Class="request-card pa-4 ma-4">
            <MudText Typo="Typo.h4" Class="mb-4">New Fuel Entry</MudText>

            <MudSelect T="string" Class="mb-3" Label="Select Boat *" Variant="Variant.Filled" @bind-Value="selectedBoat"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.DirectionsBoat"
                OpenIcon="@Icons.Material.Filled.KeyboardArrowDown"
                CloseIcon="@Icons.Material.Filled.KeyboardArrowUp">
                @foreach (var boat in boats)
                {
                    <MudSelectItem Value="@boat">@boat</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker Label="Date *" Variant="Variant.Filled" @bind-Date="logDate" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.CalendarMonth" />

            <MudDivider DividerType="DividerType.Middle"/>

            <MudText Typo="Typo.overline" Class="">Engine Hours</MudText>

            <MudNumericField T="decimal?" Variant="Variant.Filled" Label="Current Engine 1 Hours" @bind-Value="engine1Hours" Adornment="Adornment.End" Required="true" Class="mb-3"/>

            <MudNumericField T="decimal?" Variant="Variant.Filled" Label="Current Engine 2 Hours" @bind-Value="engine2Hours" Adornment="Adornment.End"  Required="true"/>
            <MudDivider DividerType="DividerType.Middle" />

            <MudText Typo="Typo.overline" Class="">Fuel Added (Gallons)</MudText>

            <MudNumericField T="decimal?" Variant="Variant.Filled" Label="Fuel Added - Engine 1" @bind-Value="fuel1" Adornment="Adornment.End"  Required="true" Class="mb-3"/>

            <MudNumericField T="decimal?" Variant="Variant.Filled" Label="Fuel Added - Engine 2" @bind-Value="fuel2" Adornment="Adornment.End"  Required="true" Class="mb-3"/>

            <MudPaper Class="fuel-log-summary">
                <MudStack Direction="Row" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudText Typo="Typo.subtitle2">Total Fuel Added:</MudText>
                    <MudText Typo="Typo.subtitle1" Class="fuel-log-accent">@combinedFuel.ToString("0.0") gal</MudText>
                </MudStack>
            </MudPaper>

            <MudDivider DividerType="DividerType.Middle" />

            <MudText Typo="Typo.overline" Class="fuel-log-section">Fuel Added- Gas Cans (Gallons)</MudText>

            <MudNumericField T="decimal?" Variant="Variant.Filled" Label="Fuel - Gas Cans (Optional)" @bind-Value="GasCans" Adornment="Adornment.End" />

            <MudDivider DividerType="DividerType.Middle" />

            <MudText Typo="Typo.overline" Class="fuel-log-section">Crew</MudText>

            <MudSelect T="string" Label="Crew Member Fueling Boat" Variant="Variant.Filled" Required="true" @bind-Value="selectedCrew" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person">
                @foreach (var crew in crewMembers)
                {
                    <MudSelectItem Value="@crew">@crew</MudSelectItem>
                }
            </MudSelect>

            <MudButton Variant="Variant.Filled" Color="Color.Warning" Class="submit-btn mt-5" StartIcon="@Icons.Material.Filled.Save" FullWidth="true" @onclick="SaveButton">Submit Fuel Entry</MudButton>
        </MudPaper>

    </MudPaper>
    
</MudContainer>
<br/>

@code {
    private string? selectedBoat;
    private string? selectedCrew;
    private DateTime? logDate = DateTime.Today;
    private decimal? engine1Hours;
    private decimal? engine2Hours;
    private decimal combinedEngineHours => (engine1Hours ?? 0m) + (engine2Hours ?? 0m);
    private decimal? fuel1;
    private decimal? fuel2;
    private decimal? GasCans;
    private decimal combinedFuel => (fuel1 ?? 0m) + (fuel2 ?? 0m) + (GasCans ?? 0m);


    private static readonly Dictionary<string, object> DecimalInputAttributes = new()
    {
        ["type"] = "text",
        ["inputmode"] = "decimal",
        ["pattern"] = "[0-9]*[.,]?[0-9]*"
    };


    private readonly List<string> boats = new()
    {
        "Towboat 1",
        "Towboat 2",
        "Towboat 3",
        "Towboat 4",
        "Towboat 5",
        "Towboat 6",
        "Towboat 7",
        "Towboat 8",
        "Towboat 9",
        "Towboat 10",
        "Towboat 11",
        "Towboat 12",
        "Towboat 14",
        "Towboat 16",
    };

    private readonly List<string> crewMembers = new();

    protected override async Task OnInitializedAsync()
    {
        await CreateFuelList();
    }

    private async Task CreateFuelList()
    {
        var users = await UserManager.Users.OrderBy(u => u.Name).ToListAsync();

        foreach (var user in users)
        {
            if (user.AddToFuelList == true)
            {
                crewMembers.Add(user.Name);
            }
        }

        //auto-select the current user if they are on the fuel list
        if (crewMembers.Contains(UserService.Name, StringComparer.OrdinalIgnoreCase))
        {
            selectedCrew = UserService.Name;
        }
        else
        {
           //do nothing, leave empty for user to select from list
        }
    }
    private async Task SaveButton()
    {
        if (string.IsNullOrWhiteSpace(selectedBoat) || string.IsNullOrWhiteSpace(selectedCrew) || logDate is null)
        {
            Snackbar.Add("Please complete all required fields.", Severity.Warning);
            return;
        }

        var entry = new FuelLogEntry
        {
            BoatName = selectedBoat,
            CrewMember = selectedCrew,
            LogDate = logDate.Value,
            Engine1Hours = engine1Hours ?? 0m,
            Engine2Hours = engine2Hours ?? 0m,
            Fuel1 = fuel1 ?? 0m,
            Fuel2 = fuel2 ?? 0m,
            GasCans = GasCans ?? 0m
        };

        await FuelLogService.AddAsync(entry);

        Snackbar.Add("Fuel log saved.", Severity.Success);

        engine1Hours = null;
        engine2Hours = null;
        fuel1 = null;
        fuel2 = null;
        GasCans = null;
        selectedBoat = null;
        selectedCrew = null;

    }


}

