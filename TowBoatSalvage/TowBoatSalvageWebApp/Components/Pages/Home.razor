@using QuestPDF.Fluent;
@using QuestPDF.Helpers;
@using QuestPDF.Infrastructure;
@using QuestPDF.Companion;
@inject DispatchSignedPdfService PdfService
@using MudBlazor
@inject IHttpContextAccessor HttpContextAccessor
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

@page "/"
@using TowBoatSalvageWebApp.Components.Account.Shared
@using TowBoatSalvageWebApp.Services

<PageTitle>TowBoatUS Portal</PageTitle>
@*NAVBAR*@
<div class="navbar">
    <div class="logo">
        <a href="/">
            <img src="assets/TowBoatLogo.png" alt="TowBoatUS Logo" class="login-logo" />
        </a>
    </div>
</div>
<section class="hero">
    <div class="hero-text">
        <h1>Marine Towing<br>Management System</h1>
        <p>Access your dashboard to manage boat salvage operations, track vessels, and coordinate rescue efforts.</p>
        <a href="#" @onclick="NavigateToApp" class="btn">➜ Login to Dashboard</a>
