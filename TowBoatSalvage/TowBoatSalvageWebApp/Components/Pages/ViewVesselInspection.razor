@using Microsoft.AspNetCore.Authorization
@using Newtonsoft.Json.Serialization
@using SQLitePCL
@using TowBoatSalvageWebApp.Models
@using TowBoatSalvageWebApp.Services
@inject VehicleInspectionService VehicleInspection
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject VehicleInspectionPdfService VehicleInspectionPdfService
@inject IJSRuntime JS
@attribute [Authorize]

<PageTitle>Vessel Equipment Inspections</PageTitle>



<MudContainer MaxWidth="MaxWidth.False">
    <MudPaper Elevation="1" Class="wo-table-wrap">
        @if (_isLoading)
        {
            <div class="pa-6 d-flex justify-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (inspections.Count == 0)
        {
            <div class="pa-6">
                <MudText Typo="Typo.body1" Align="Align.Center">No Vessel Inspections found.</MudText>
            </div>
        }
        else
        {
            <table class="wo-table">
                <thead>
                    <tr>
                        <th>DATE</th>
                        <th>VESSEL</th>
                        <th>COMPLETED BY</th>
                        <th>ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inspection in PagedInspections)
                    {
                        <tr>
                            <td>@inspection.DateOfInspection?.ToString("d")</td>
                            <td class="font-weight-bold">@inspection.VesselNumber</td>
                            <td class="font-weight-bold">@inspection.EmployeeOrCaptain</td>

                            <td>
                                <div class="wo-row-actions">
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                   Color="Color.Error" class="wo-delete-btn" AriaLabel="Delete vessel inspection"
                                                   OnClick="@(() => ConfirmDeleteOrderAsync(inspection))" />

                                    <MudIconButton
                                    Icon="@(inspection.bHasBeenDownloaded ? @Icons.Material.Filled.DownloadDone : @Icons.Material.Filled.Download)"
                                    Size="Size.Small" Color="Color.Info" AriaLabel="Download inspection PDF"
                                    OnClick="@(() => DownloadPdfAsync(inspection))" />
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (inspections.Count > PageSize)
            {
                <div class="wo-pagination-wrap">
                    <MudText Typo="Typo.caption" class="wo-pagination-text">
                        Page @_currentPage of @TotalPages
                    </MudText>

                    <MudPagination Count="@TotalPages" @bind-Selected="_currentPage" ShowFirstButton="true" ShowLastButton="true" BoundaryCount="1" Size="Size.Small" />         
                </div>
            }
        }
    </MudPaper>
</MudContainer>



@code {
    [Parameter] public bool IsFromAdminDashboard { get; set; }

    private bool _isLoading = false;
    private int _currentPage = 1;
    private const int PageSize = 10;

    private int TotalPages
    {
        get
        {
            var pages = (int)Math.Ceiling(inspections.Count / (double)PageSize);
            return Math.Max(1, pages);
        }
    }

    private List<VehicleInspection> PagedInspections
    {
        get
        {
            if (_currentPage < 1) _currentPage = 1;
            if (_currentPage > TotalPages) _currentPage = TotalPages;

            return inspections
                .Skip((_currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
    }

    private List<VehicleInspection> inspections = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadInspectionsAsync();
    }

    private async Task LoadInspectionsAsync()
    {
        _isLoading = true;
        var year = DateTime.Now.Year;
        try
        {
            inspections = await VehicleInspection.GetVehicleInspectionsFromSelectedYearAsync(year);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error while fetching vessel inspection: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ConfirmDeleteOrderAsync(VehicleInspection vehicleInspection)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            title: "Delete Vessel Inspection",
            markupMessage: (MarkupString)"Are you sure you want to delete this?",
            yesText: "Delete",
            cancelText: "Cancel"
        );

        if (confirm == true)
        {
            await DeleteInspectionAsync(vehicleInspection);
        }
    }

    private async Task DeleteInspectionAsync(VehicleInspection vehicleInspection)
    {
        try
        {
            await VehicleInspection.DeleteAsync(vehicleInspection.Id);
            Snackbar.Add($"Successfully deleted inspection.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to delete inspection: {ex.Message}", Severity.Error);
        }

        await LoadInspectionsAsync();

    }

    private async Task DownloadPdfAsync(VehicleInspection inspection)
    {
        try
        {
            var fullInspection = await VehicleInspection.GetInspectionForPdfByIdAsync(inspection.Id);

            if (fullInspection is null)
            {
                Snackbar.Add("Inspection not found.", Severity.Warning);
                return;
            }
            var pdfBytes = VehicleInspectionPdfService.BuildPdf(fullInspection);
            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"VesselInspection_{fullInspection.VesselNumber}_{fullInspection.DateOfInspection?.ToString("d")}.pdf";

            await JS.InvokeVoidAsync("pdfViewer.downloadPdf", base64, fileName);



        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to generate PDF: {ex.Message}", Severity.Error);
        }
    }
}

