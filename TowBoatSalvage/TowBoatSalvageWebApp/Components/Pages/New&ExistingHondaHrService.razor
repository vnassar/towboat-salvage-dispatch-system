@page "/NewHondaHrService"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TowBoatSalvageWebApp.Data
@using TowBoatSalvageWebApp.Services
@using TowBoatSalvageWebApp.Models
@inject Honda500HrService Honda500HrService
@inject UserManager<ApplicationUser> UserManager
@inject UserService UserService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>AMS Honda 500Hr Service</PageTitle>


<MudContainer MaxWidth="MaxWidth.False" Class="pa-0 maintenance-page">

    <TowBoatSalvageWebApp.Components.Pages.NavBar.NavigationBar />

    <MudPaper Elevation="0" Square="true" Class="maintenance-shell mx-auto">
        <!-- Header -->
        <MudPaper Elevation="0" Square="true" Class="maintenance-header px-4 pt-6 pb-2">
            <div class="header-title">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Class="mr-2" />
                <MudText Typo="Typo.h5" Class="header-title-text">Fleet Maintenance</MudText>
            </div>

            <div class="header-tabs mt-4">
                <div class="@GetTabClass(HondaServiceTab.NewRequest)"
                     @onclick="() => SetTab(HondaServiceTab.NewRequest)">
                    <MudIcon Icon="@Icons.Material.Filled.Anchor" Size="Size.Small" Class="mr-1" />
                    <span>New</span>
                </div>

                <div class="@GetTabClass(HondaServiceTab.OpenHondaServices)"
                     @onclick="() => SetTab(HondaServiceTab.OpenHondaServices)">
                    <MudIcon Icon="@Icons.Material.Filled.Build" Size="Size.Small" Class="mr-1" />
                    <span>Open Services</span>
                    <MudBadge Content="@OpenServicesCount" Color="Color.Warning" Class="ml-2" />
                </div>
            </div>
        </MudPaper>

            @if (ActiveTab == HondaServiceTab.NewRequest)
            {
                <!-- New Request -->
                <MudPaper Elevation="2" Class="request-card pa-4 ma-4">
                    <MudText Typo="Typo.h4" Class="mb-4">New Service</MudText>

                    <MudSelect T="string" Label="Select Boat" Variant="Variant.Filled" Margin="Margin.Dense" Class="mb-3"
                               @bind-Value="selectedBoat">
                        @foreach (var boat in boats)
                        {
                            <MudSelectItem Value="@boat">@boat</MudSelectItem>
                        }
                    </MudSelect>

                    <MudDatePicker Label="Date" Variant="Variant.Filled" Margin="Margin.Dense" Class="mb-3"
                                   @bind-Date="_dateOfInspection" />

                    <MudGrid Class="mb-2">
                        <MudItem xs="12" sm="6">
                            <MudTextField T="int" Label="Engine 1 (hrs)" Placeholder="e.g. 1250"
                                          InputType="InputType.Number" Variant="Variant.Filled" Margin="Margin.Dense"
                                          @bind-Value="_engineHours1" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField T="int" Label="Engine 2 (hrs)" Placeholder="e.g. 1250"
                                          InputType="InputType.Number" Variant="Variant.Filled" Margin="Margin.Dense"
                                          @bind-Value="_engineHours2" Required="true" />
                        </MudItem>
                    </MudGrid>

                    <MudSelect T="string" Label="Select Crew" Variant="Variant.Filled" Margin="Margin.Dense" Class="mb-3"
                               @bind-Value="selectedCrew">
                        @foreach (var crew in crewMembers)
                        {
                            <MudSelectItem Value="@crew">@crew</MudSelectItem>
                        }
                    </MudSelect>

                    <MudDivider Class="my-3" />

                    <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Class="submit-btn"
                               OnClick="StartNew500HrServiceAsync">
                        Start Honda Service
                    </MudButton>
                </MudPaper>
            }
            else
            {
                <!-- Existing Services -->
                <div class="open-orders-wrap pa-4">
                    <div class="d-flex align-center justify-space-between mb-3">
                        <MudText Typo="Typo.h5" Class="font-weight-bold">Needs Attention</MudText>
                        <MudChip T="int" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">@OpenServicesCount
                            Orders
                        </MudChip>
                    </div>

                    @if (OpenServicesCount == 0)
                    {
                        <MudPaper Elevation="1" Class="request-card pa-4">
                            <MudText Typo="Typo.body1" Align="Align.Center">No open services right now.</MudText>
                        </MudPaper>
                    }
                    else
                    {
                        @foreach (var order in _allServices.Where(x => !x.bIsResolved))
                        {
                            <MudPaper Elevation="2" Class="open-order-card pa-3 mb-4">
                                <div class="d-flex justify-space-between"> 
                                    <div class="d-flex align-start mb-2">
                                        <div class="order-boat-icon mr-3">
                                            <MudIcon Icon="@Icons.Material.Outlined.DirectionsBoat" />
                                        </div>
                                        <div>
                                            <MudText Typo="Typo.h5" Class="font-weight-bold">@order.BoatNumber</MudText>
                                            <MudText Typo="Typo.body2" Class="order-date">
                                                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="mr-1" />
                                                @order.DateCompleted
                                            </MudText>
                                        </div>
                                    </div>

                                    <div class="delete">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                   Color="Color.Error" class="wo-delete-btn" aria-label="Delete vessel inspection"
                                                   OnClick="@(() => ConfirmDeleteOrderAsync(order))" />
                                    </div>
                                </div>

                                <MudPaper Elevation="0" Class="engines-box pa-3 mb-3">
                                    <MudGrid>
                                        <MudItem xs="6">
                                            <MudText Typo="Typo.caption" Class="engine-label">ENGINE 1</MudText>
                                            <MudText Typo="Typo.h6"><strong>@order.EngineHours1</strong> <span
                                                class="engine-hrs">hrs</span></MudText>
                                            </MudItem>
                                            <MudItem xs="6">
                                                <MudText Typo="Typo.caption" Class="engine-label">ENGINE 2</MudText>
                                                <MudText Typo="Typo.h6"><strong>@order.EngineHours2</strong> <span
                                                    class="engine-hrs">hrs</span></MudText>
                                                </MudItem>
                                            </MudGrid>
                                        </MudPaper>

                                        <MudDivider Class="my-3" />

                                        <!-- Resolve button -->
                                        <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true"
                                                   OnClick="@(() => ResumeHondaServiceAsync(order))">
                                            <MudIcon Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Class="mr-1" />
                                            Resume Honda Service
                                        </MudButton>
                                    </MudPaper>
                                }
                            }
                        </div>
                    }
                </MudPaper>
        </MudContainer>









@code {

    private string? selectedBoat;
    private string? selectedCrew;
    private readonly List<string> boats = new()
    {
        "Towboat 1",
        "Towboat 2",
        "Towboat 3",
        "Towboat 4",
        "Towboat 5",
        "Towboat 6",
        "Towboat 7",
        "Towboat 8",
        "Towboat 9",
        "Towboat 10",
        "Towboat 11",
        "Towboat 12",
        "Towboat 14",
        "Towboat 16",
    };

    private readonly List<string> crewMembers = new();
    private DateTime? _dateOfInspection = DateTime.Now;

    private int _engineHours1;
    private int _engineHours2;

    private int OpenServicesCount;
    private List<Honda500Hr> _allServices = new();

    private void SetTab(HondaServiceTab tab) => ActiveTab = tab;
    private HondaServiceTab ActiveTab { get; set; } = HondaServiceTab.NewRequest;

    private string GetTabClass(HondaServiceTab tab) => ActiveTab == tab ? "header-tab active" : "header-tab";

    private enum HondaServiceTab
    {
        NewRequest,
        OpenHondaServices
    }

    protected override async Task OnInitializedAsync()
    {
        await CreateCrewList();

        _allServices = await Honda500HrService.GetHonda500HrServiceFromSelectedYear(DateTime.Now.Year);
        OpenServicesCount = _allServices.Count(s => !s.bIsResolved);
    }

    private async Task CreateCrewList()
    {
        var users = await UserManager.Users.OrderBy(u => u.Email).ToListAsync();

        foreach (var user in users)
        {
            crewMembers.Add(user.Name);
        }

        //set selected user as the signed in user
        selectedCrew = UserService.Name;
    }

    private async Task StartNew500HrServiceAsync()
    {
        if (selectedCrew is null) return;
        if (selectedBoat is null) return;

        try
        {
            var hondaService = await Honda500HrService.CreateNewHonda500HrServiceAsync(selectedCrew, _engineHours1, _engineHours2, selectedBoat);

            var url = $"{Nav.BaseUri}Honda500HrService/{hondaService.Id}";

            Nav.NavigateTo($"{url}", true);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error starting new 500Hr service: {ex.Message}", Severity.Error);
            return;
        }
    }

    private async Task ResumeHondaServiceAsync(Honda500Hr order)
    {
        var url = $"{Nav.BaseUri}Honda500HrService/{order.Id}";
        Nav.NavigateTo($"{url}", true);
    }

    private async Task ConfirmDeleteOrderAsync(Honda500Hr order)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            title: "Delete Honda 500Hr Service",
            markupMessage: (MarkupString)"Are you sure you want to delete this?",
            yesText: "Delete",
            cancelText: "Cancel"
        );

        if (confirm == true)
        {
            await DeleteOrderAsync(order);
        }
    }

    private async Task DeleteOrderAsync(Honda500Hr order)
    {
        try
        {
            await Honda500HrService.DeleteAsync(order.Id);
            Snackbar.Add($"Successfully deleted Honda 500Hr service.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to delete Honda 500Hr service: {ex.Message}", Severity.Error);
        }

        _allServices = await Honda500HrService.GetHonda500HrServiceFromSelectedYear(DateTime.Now.Year);
        OpenServicesCount = _allServices.Count(s => !s.bIsResolved);
    }
}


<style>
    .maintenance-page {
        background: #eef0f3;
        min-height: 100vh;
    }

    .maintenance-shell {
        max-width: 450px;
        min-height: 100vh;
        background: #eef0f3;
    }

    .maintenance-header {
        background: #12243f;
        color: #fff;
    }

    .header-title {
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffb300;
        font-weight: 700;
    }

    .header-title-text {
        color: #fff;
        font-weight: 700;
    }

    .header-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        color: #fff;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .header-tab {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 14px 8px 12px 8px;
        font-weight: 600;
        opacity: 0.95;
        border-bottom: 3px solid transparent;
        cursor: pointer;
    }

    .header-tab.active {
        border-bottom: 3px solid #f59e0b;
    }

    .request-card {
        border-radius: 14px;
        background: #f8f9fb;
        @*f8f9fb*@
    }

    .add-issue-btn {
        min-height: 52px;
        border-radius: 10px;
        background-color: #8f96a3 !important;
        color: #fff !important;
    }

    .no-issues-box {
        border-radius: 10px;
        background: #eef1f5;
        color: #6b7280;
    }

    .issue-row {
        border-radius: 10px;
        background: #f3f6fa;
        border: 1px solid #d4dce8;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .issue-remove-btn {
        color: #8ea0b5;
    }

    .submit-btn {
        min-height: 56px;
        border-radius: 12px;
        font-size: 1.15rem;
        font-weight: 700;
        color: #101828 !important;
    }

    .open-order-card {
        border-radius: 12px;
        background: #f8f9fb;
    }

    .order-boat-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        background: #eef1f5;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
    }

    .order-date {
        color: #61708a;
        display: flex;
        align-items: center;
    }

    .engines-box {
        border-radius: 8px;
        background: #edf1f7;
    }

    .engine-label {
        color: #5f6f86;
        font-weight: 700;
        letter-spacing: .6px;
    }

    .engine-hrs {
        color: #5f6f86;
        font-size: .9rem;
    }

    .issue-alert-icon {
        color: #f59e0b;
    }

    .order-issue-item {
        border-radius: 8px;
        background: #f8f6f0;
        border: 1px solid #f1e3b8;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .issue-dot {
        color: #e9ad00;
        font-size: 1.2rem;
        line-height: 1;
    }

    .add-correction-btn {
        border-radius: 8px;
        background: #e8eef9 !important;
        color: #1d4ed8 !important;
    }

    .issue-correction-list {
        display: flex;
        flex-direction: column;
    }

    .issue-box {
        border-radius: 10px;
        background: #f8f6f0;
        border: 1px solid #f1e3b8;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .correction-box {
        margin-left: 22px;
        border-radius: 10px;
        background: #edf4ff;
        border: 1px solid #cddffc;
        position: relative;
    }

    .correction-box::before {
        content: "";
        position: absolute;
        left: -14px;
        top: 16px;
        width: 12px;
        border-top: 2px dashed #b7c7e6;
    }

    .correction-label {
        color: #425b84;
        font-weight: 700;
        letter-spacing: .2px;
    }

    .update-correction-btn {
        border-radius: 8px;
    }
</style>