
@page "/test11"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@using TowBoatSalvageWebApp.Data
@using TowBoatSalvageWebApp.Models
@using TowBoatSalvageWebApp.Services
@inject SalvageTableService TableService
@inject UserService UserService
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ToastService ToastService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@implements IAsyncDisposable
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<MudBreakpointProvider OnBreakpointChanged="OnBreakpointChanged" />

<AuthorizeView>
    @* ── Mobile view ── *@
    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <MudContainer MaxWidth="MaxWidth.Small" Class="pa-2">
            <TowBoatSalvageWebApp.Components.Pages.NavBar.NavigationBar />
            @* Header *@
            <MudPaper Elevation="1" Class="pa-3">
                <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                    <MudText Typo="Typo.h6">Salvage Tracker</MudText>
                    <MudStack Row Spacing="1">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                       Color="Color.Primary"
                                       OnClick="LoadBoardAsync"
                                       Disabled="isLoading" />
                        
                    </MudStack>
                </MudStack>
            </MudPaper>

            @if (isLoading)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-2" />
            }
            else
            {
                <MudTabs Rounded="true" Class="mt-3" ApplyEffectsToContainer="true" PanelClass="pa-2">
                    @* ── Active tab ── *@
                    <MudTabPanel Text="@($"Active ({_activeRows.Count})")">
                        @if (_activeRows.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-2">No active dispatches.</MudAlert>
                        }
                        else
                        {
                            @foreach (var row in _activeRows)
                            {
                                var status = GetStatusValue(row);
                                var address = GetAddressFromNotes(row);
                                var vesselSummary = GetVesselSummary(row);
                                var phone = GetCellValue(row, "Phone Number");
                                var fileUploadColumn = Columns?.FirstOrDefault(c => c.Type == "FileUpload");

                                <MudCard Elevation="2" Class="mb-3">
                                    <MudCardHeader>
                                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%">
                                            <MudText Typo="Typo.subtitle1">@GetCellValue(row, "Name")</MudText>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@GetStatusColor(status)"
                                                     Variant="Variant.Filled">
                                                @GetStatusLabel(status)
                                            </MudChip>
                                        </MudStack>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudStack Spacing="1">
                                            @if (!string.IsNullOrWhiteSpace(phone))
                                            {
                                                <MudText Typo="Typo.body2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-1" />
                                                    <MudLink Href="@($"tel:{phone}")">@phone</MudLink>
                                                </MudText>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(address))
                                            {
                                                <MudText Typo="Typo.body2">
                                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-1" />
                                                    <MudLink Href="@GetGoogleMapsUrl(address)" Target="_blank" Rel="noopener noreferrer">
                                                        @address
                                                    </MudLink>
                                                </MudText>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(vesselSummary))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Dark">
                                                    <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Size="Size.Small" Class="mr-1" />
                                                    @vesselSummary
                                                </MudText>
                                            }
                                        </MudStack>

                                        <MudDivider Class="my-2" />

                                        @* Action buttons *@
                                        <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Notes"
                                                       OnClick="() => OpenNotesFromCard(row)">
                                                Notes
                                            </MudButton>
                                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.PhotoLibrary"
                                                       OnClick="() => OpenPhotosFromCard(row)">
                                                Photos
                                            </MudButton>
                                            @if (fileUploadColumn is not null)
                                            {
                                                <MudButton Variant="Variant.Text" Size="Size.Small"
                                                           StartIcon="@Icons.Material.Filled.UploadFile"
                                                           HtmlTag="label">
                                                    Upload
                                                    <InputFile OnChange="e => UploadMultipleFiles(e, row.Id, fileUploadColumn.Id)"
                                                               accept="image/*" multiple style="display:none" />
                                                </MudButton>
                                            }
                                        </MudStack>

                                        @* Status transition buttons *@
                                        <MudStack Row Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                                            @if (IsNewOrAssignedStatus(status))
                                            {
                                                <MudButton Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small"
                                                           OnClick="() => MarkRowInProgress(row)">
                                                    Mark In Progress
                                                </MudButton>
                                            }
                                            @if (!IsCompletedStatus(status))
                                            {
                                                <MudButton Color="Color.Success" Variant="Variant.Filled" Size="Size.Small"
                                                           OnClick="() => MarkRowComplete(row)">
                                                    Mark Complete
                                                </MudButton>
                                            }
                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                    </MudTabPanel>

                    @* ── Completed tab ── *@
                    <MudTabPanel Text="@($"Completed ({FilteredCompletedRows.Count})")">
                        <MudStack Spacing="2" Class="mb-3">
                            <MudSelect T="string" Label="Show" Dense="true"
                                       Value="completedFilter"
                                       ValueChanged="OnCompletedFilterChanged">
                                <MudSelectItem T="string" Value="@("all")">All</MudSelectItem>
                                <MudSelectItem T="string" Value="@("30days")">Last 30 Days</MudSelectItem>
                                <MudSelectItem T="string" Value="@("60days")">Last 60 Days</MudSelectItem>
                                <MudSelectItem T="string" Value="@("90days")">Last 90 Days</MudSelectItem>
                                <MudSelectItem T="string" Value="@("thisYear")">This Year</MudSelectItem>
                                <MudSelectItem T="string" Value="@("lastYear")">Last Year</MudSelectItem>
                            </MudSelect>

                            <MudTextField T="string"
                                          Label="Search"
                                          Dense="true"
                                          Immediate="true"
                                          DebounceInterval="300"
                                          Value="completedSearch"
                                          ValueChanged="OnSearchChanged"
                                          Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" />
                        </MudStack>

                        @if (FilteredCompletedRows.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info">No completed dispatches.</MudAlert>
                        }
                        else
                        {
                            @foreach (var row in FilteredCompletedRows)
                            {
                                var status = GetStatusValue(row);
                                var address = GetAddressFromNotes(row);
                                var vesselSummary = GetVesselSummary(row);
                                var phone = GetCellValue(row, "Phone Number");

                                <MudCard Elevation="1" Class="mb-3">
                                    <MudCardHeader>
                                        <MudStack Row AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%">
                                            <MudText Typo="Typo.subtitle1">@GetCellValue(row, "Name")</MudText>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@GetStatusColor(status)"
                                                     Variant="Variant.Filled">
                                                @GetStatusLabel(status)
                                            </MudChip>
                                        </MudStack>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudStack Spacing="1">
                                            @if (!string.IsNullOrWhiteSpace(phone))
                                            {
                                                <MudText Typo="Typo.body2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mr-1" />
                                                    <MudLink Href="@($"tel:{phone}")">@phone</MudLink>
                                                </MudText>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(address))
                                            {
                                                <MudText Typo="Typo.body2">
                                                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Class="mr-1" />
                                                    <MudLink Href="@GetGoogleMapsUrl(address)" Target="_blank" Rel="noopener noreferrer">
                                                        @address
                                                    </MudLink>
                                                </MudText>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(vesselSummary))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Dark">
                                                    <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Size="Size.Small" Class="mr-1" />
                                                    @vesselSummary
                                                </MudText>
                                            }
                                        </MudStack>

                                        <MudDivider Class="my-2" />

                                        <MudStack Row Wrap="Wrap.Wrap" Spacing="1">
                                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.Notes"
                                                       OnClick="() => OpenNotesFromCard(row)">
                                                Notes
                                            </MudButton>
                                            <MudButton Variant="Variant.Text" Size="Size.Small"
                                                       StartIcon="@Icons.Material.Filled.PhotoLibrary"
                                                       OnClick="() => OpenPhotosFromCard(row)">
                                                Photos
                                            </MudButton>
                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            }
                        }
                    </MudTabPanel>
                </MudTabs>
            }
        </MudContainer>
    </MudHidden>

    @* ── Desktop redirect ── *@
    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        @*
            <SalvageBoard />

            <MudContainer MaxWidth="MaxWidth.Medium" Class="pa-6">
            <MudAlert Severity="Severity.Info">
                This page is mobile-only. Use the desktop dashboard for the full table view.
            </MudAlert>
            <MudButton Class="mt-3" Variant="Variant.Filled" Color="Color.Primary"
                       Href="/salvage-tracker">
                Open Desktop Dashboard
            </MudButton>
        </MudContainer>
        *@
        <SalvageBoard />
    </MudHidden>
</AuthorizeView>

