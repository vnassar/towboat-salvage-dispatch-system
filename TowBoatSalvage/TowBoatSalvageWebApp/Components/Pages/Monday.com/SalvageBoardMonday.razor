@page "/salvage-tracker-tuesday"
@using Microsoft.AspNetCore.Authorization
@using TowBoatSalvageWebApp.Data
@using TowBoatSalvageWebApp.Models
@using TowBoatSalvageWebApp.Services
@using Microsoft.AspNetCore.Components.Forms
@inject SalvageTableService TableService
@inject IJSRuntime JS
@inject IWebHostEnvironment Env
@inject ToastService ToastService

@implements IAsyncDisposable

@attribute [Authorize]

<link href="~/salvage-tracker-monday.css" rel="stylesheet" />

<PageTitle>Salvage Tracker</PageTitle>

<AuthorizeView>
    <TowBoatSalvageWebApp.Components.Pages.NavBar.NavigationBar />
    <div class="monday-board@(isLongTextModalOpen ? " monday-modal-open" : "")">
        <header class="monday-header">
            <div class="monday-title-row">
                <div class="monday-title-left">
                    <h1>Salvage Tracker</h1>
                    <span class="monday-title-caret">?</span>
                </div>
                <div class="monday-title-actions">
                    <button class="monday-icon-btn" type="button">?</button>
                </div>
            </div>
            <div class="monday-tabs">
                <button class="monday-tab active" type="button">Main table</button>
                <button class="monday-tab" type="button">Cards</button>
                <button class="monday-tab add" type="button">+</button>
            </div>
            <div class="monday-toolbar">
                <button class="monday-primary" @onclick="AddRow" disabled="@(!Columns.Any())">
                    New g# or company
                </button>
                <div class="monday-toolbar-items">
                    <button class="monday-toolbar-btn" type="button">Search</button>
                    <button class="monday-toolbar-btn" type="button">Person</button>
                    <button class="monday-toolbar-btn" type="button">Filter</button>
                    <button class="monday-toolbar-btn" type="button">Sort</button>
                    <button class="monday-toolbar-btn" type="button">Hide</button>
                    <button class="monday-toolbar-btn" type="button">Group by</button>
                </div>
            </div>
        </header>

        <section class="monday-group">
            <div class="monday-group-header monday-group-active">
                <span class="monday-group-chevron">?</span>
                <span class="monday-group-title">To-Do</span>
                <span class="monday-group-count">@ActiveRows.Count</span>
            </div>
            <div class="monday-table-wrapper">
                <table class="monday-table">
                    <thead>
                        <tr>
                            <th class="monday-sticky monday-control-col"></th>
                            @foreach (var col in Columns)
                            {
                                <th>
                                    <div class="monday-col-header">
                                        <span>@col.Label</span>
                                        <button class="monday-col-menu" @onclick="e => ShowColumnMenu(col.Id, e)" @ref="@columnMenuButtonRefs[col.Id]" @onclick:stopPropagation aria-label="Column menu">
                                            ...
                                        </button>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <div class="monday-card-list">
                            @if (!ActiveRows.Any())
                            {
                                <p class="monday-empty">No dispatches available for display</p>
                            }
                            @{
                                var fileUploadColumn = Columns.FirstOrDefault(c => c.Label == "Images");
                            }
                            @foreach (var row in ActiveRows)
                            {
                                <SalvageCard Row="row" Columns="Columns"
                                             OnEdit="() => EditRow(row)"
                                             OnMarkInProgress="() => MarkRowInProgress(row)"
                                             OnMarkComplete="() => MarkRowComplete(row)"
                                             OnOpenNotes="() => OpenNotesFromCard(row)"
                                             OnOpenPhotos="() => OpenPhotosFromCard(row)"
                                             OnUploadPhoto="e => UploadMultipleFiles(e,row.Id, fileUploadColumn!.Id)" />
                            }
                        </div>
                        @foreach (var row in ActiveRows)
                        {
                            <tr class="monday-row" @key="row.Id" @onmouseover="@(() => hoverRow = row.Id)" @onmouseout="@(() => hoverRow = null)">
                                <td class="monday-sticky monday-control-col">
                                    <div class="monday-row-controls">
                                        <input type="checkbox" class="monday-checkbox" />
                                        <button class="monday-row-menu" @onclick="(e => ShowRowMenu(row.Id, e))" @onclick:stopPropagation aria-label="Row menu">
                                            ...
                                        </button>
                                    </div>
                                    @if (activeRowMenuId == row.Id)
                                    {
                                        <div id="row-menu-@row.Id" class="monday-row-menu-dropdown">
                                            <button class="dropdown-item" @onclick="() => OpenQuickEntryModal(row.Id)">Quick Entry</button>
                                            <button class="dropdown-item text-danger" @onclick="() => DeleteRow(row.Id)">Delete Row</button>
                                        </div>
                                    }
                                </td>
                                @foreach (var col in Columns)
                                {
                                    if (col.Label == "G# OR Company")
                                    {
                                        <td class="monday-cell monday-main-col">
                                            <span class="input-tooltip-container">
                                                @RenderCell(row, col)
                                                @{
                                                    var cell = row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
                                                    var value = cell?.Value ?? "";
                                                }
                                                @if (!string.IsNullOrWhiteSpace(value) && value.Length > 15)
                                                {
                                                    <span class="input-tooltip">
                                                        <span>@value</span>
                                                    </span>
                                                }
                                            </span>
                                        </td>
                                    }
                                    else if (col.Type == "FileUpload")
                                    {
                                        <td class="monday-cell monday-file-col">
                                            <span class="monday-file-list">
                                                @{
                                                    var cell = row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
                                                    var files = cell?.Files?.ToList() ?? new List<SalvageFile>();
                                                }
                                                @if (files.Count > 0)
                                                {
                                                    var toShow = files.Count > 4 ? files.Take(4) : files;
                                                    foreach (var file in toShow)
                                                    {
                                                        <span class="monday-thumb" @onclick="() => OpenGallery(files, file.FileName)">
                                                            <img src="@($"/salvage_uploads/{file.FileName}")" alt="file thumbnail" />
                                                        </span>
                                                    }
                                                    if (files.Count > 4)
                                                    {
                                                        <span class="monday-more" @onclick="() => OpenGallery(files, files.First().FileName)">+@(files.Count - 4)</span>
                                                    }
                                                }
                                                <label class="monday-upload" @onclick:stopPropagation>
                                                    +
                                                    <InputFile OnChange="async e => UploadMultipleFiles(e, row.Id, col.Id)" multiple style="display:none" @onclick:stopPropagation />
                                                </label>
                                            </span>
                                        </td>
                                    }
                                    else if (col.Type == "DocumentUpload")
                                    {
                                        <td class="monday-cell monday-doc-col">
                                            <div class="monday-doc-list">
                                                @{
                                                    var cell = row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
                                                    var files = cell?.Files?.ToList() ?? new List<SalvageFile>();

                                                    var docsToShow = files.Take(2).ToList();
                                                    var docOverflow = files.Count - docsToShow.Count;
                                                }
                                                @foreach (var file in docsToShow)
                                                {
                                                    var baseUrl = "https://towboatustb.com";
                                                    var fileUrl = $"{baseUrl}/salvage_uploads/{file.FileName}";
                                                    var officeViewerUrl = $"https://view.officeapps.live.com/op/view.aspx?src={Uri.EscapeDataString(fileUrl)}";

                                                    <span class="monday-doc">
                                                        @if (file.FileType == "application/pdf")
                                                        {
                                                            <a href="@($"/salvage_uploads/{file.FileName}")" target="_blank">
                                                                <i class="fade fa-file-pdf-o"></i>
                                                                <span class="monday-doc-name" title="@file.OriginalName">@file.OriginalName</span>
                                                            </a>
                                                        }
                                                        else if (file.FileType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
                                                        file.FileType == "application/msword" ||
                                                        file.FileType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" ||
                                                        file.FileType == "application/vnd.openxmlformats-officedocument.presentationml.presentation" ||
                                                        file.FileType == "application/vnd.ms-excel")
                                                        {
                                                            <a href="@officeViewerUrl" target="_blank" rel="noopener">
                                                                <i class="fa fa-file-word-o"></i>
                                                                <span class="monday-doc-name" title="@file.OriginalName">@file.OriginalName</span>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="@($"/salvage_uploads/{file.FileName}")" target="_blank">
                                                                <i class="fa fa-file-o"></i>
                                                                <span class="monday-doc-name" title="@file.OriginalName">@file.OriginalName</span>
                                                            </a>
                                                        }
                                                        <button class="monday-doc-delete" title="Delete" @onclick="() => DeleteFileAsync(file.Id)">
                                                            <i class="fa fa-trash"></i>
                                                        </button>
                                                    </span>
                                                }
                                                @if (docOverflow > 0)
                                                {
                                                    <span class="monday-more" @onclick="() => OpenDocGallery(files)">+@docOverflow more</span>
                                                }
                                                <label class="monday-upload" @onclick:stopPropagation>
                                                    +
                                                    <InputFile OnChange="e => UploadDocumentFiles(e, row.Id, col.Id)" multiple style="display:none" @onclick:stopPropagation />
                                                </label>
                                            </div>
                                        </td>
                                    }
                                    else if (col.Type == "LongText")
                                    {
                                        var cell = row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
                                        var value = cell?.Value ?? "";

                                        <td class="monday-cell">
                                            <span class="input-tooltip-container">
                                                <input class="form-control" readonly value="@value" @onclick="() => OpenLongTextModal(row, col)" />
                                                @if (!string.IsNullOrWhiteSpace(value) && value.Length > 15)
                                                {
                                                    <span class="input-tooltip">
                                                        <div class="tooltip-content">@value</div>
                                                    </span>
                                                }
                                            </span>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="monday-cell">
                                            <span class="input-tooltip-container">
                                                @RenderCell(row, col)
                                                @{
                                                    var cell = row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
                                                    var value = cell?.Value ?? "";
                                                }
                                                @if (!string.IsNullOrWhiteSpace(value) && value.Length > 15)
                                                {
                                                    <span class="input-tooltip">
                                                        <span>@value</span>
                                                    </span>
                                                }
                                            </span>
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="monday-group">
            <div class="monday-group-header monday-group-complete">
                <span class="monday-group-chevron">?</span>
                <span class="monday-group-title">Completed</span>
                <span class="monday-group-count">@FilteredCompletedRows.Count</span>
                <div class="monday-group-controls">
                    <label>
                        Show:
                        <select @oninput="OnCompletedFilterChnaged" value="@completedFilter" class="form-select form-select-sm">
                            <option value="all">All</option>
                            <option value="30days">Last 30 Days</option>
                            <option value="60days">Last 60 Days</option>
                            <option value="90days">Last 90 Days</option>
                            <option value="thisYear">This Year</option>
                            <option value="lastYear">Last Year</option>
                        </select>
                    </label>
                    <input class="form-control form-control-sm" placeholder="Search dispatch..." @oninput="OnSearchChanged" value="@completedSearch" />
                </div>
            </div>
            <div class="monday-table-wrapper">
                <table class="monday-table">
                    <thead>
                        <tr>
                            <th class="monday-sticky monday-control-col"></th>
                            @foreach (var col in Columns)
                            {
                                <th>
                                    <div class="monday-col-header">
                                        <span>@col.Label</span>
                                    </div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in FilteredCompletedRows)
                        {
                            <tr class="monday-row" @key="row.Id" @onmouseover="@(() => hoverRow = row.Id)" @onmouseout="@(() => hoverRow = null)">
                                <td class="monday-sticky monday-control-col">
                                    <div class="monday-row-controls">
                                        <input type="checkbox" class="monday-checkbox" />
                                        <button class="monday-row-menu" @onclick="(e => ShowRowMenu(row.Id, e))" @onclick:stopPropagation aria-label="Row menu">
                                            ...
                                        </button>
                                    </div>
                                    @if (activeRowMenuId == row.Id)
                                    {
                                        <div id="row-menu-@row.Id" class="monday-row-menu-dropdown">
                                            <button class="dropdown-item" @onclick="() => OpenQuickEntryModal(row.Id)">Quick Entry</button>
                                            <button class="dropdown-item text-danger" @onclick="() => DeleteRow(row.Id)">Delete Row</button>
                                        </div>
                                    }
                                </td>
                                @foreach (var col in Columns)
                                {
                                    if (col.Label == "G# OR Company")
                                    {
                                        <td class="monday-cell monday-main-col">
                                            <span class="input-tooltip-container">
                                                @RenderCell(row, col)
                                                @{
                                                    var cell = row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
                                                    var value = cell?.Value ?? "";
                                                }
                                                @if (!string.IsNullOrWhiteSpace(value) && value.Length > 15)
                                                {
                                                    <span class="input-tooltip">
                                                        <span>@value</span>
                                                    </span>
                                                }
                                            </span>
                                        </td>
                                    }
                                    else if (col.Type == "FileUpload")
                                    {
                                        <td class="monday-cell monday-file-col">
                                            <span class="monday-file-list">
                                                @{
                                                    var cell = row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
                                                    var files = cell?.Files?.ToList() ?? new List<SalvageFile>();
                                                }
                                                @if (files.Count > 0)
                                                {
                                                    var toShow = files.Count > 3 ? files.Take(3) : files;
                                                    foreach (var file in toShow)
                                                    {
                                                        <span class="monday-thumb" @onclick="() => OpenGallery(files, file.FileName)">
                                                            <img src="@($"/salvage_uploads/{file.FileName}")" alt="file thumbnail" />
                                                        </span>
                                                    }
                                                    if (files.Count > 3)
                                                    {
                                                        <span class="monday-more" @onclick="() => OpenGallery(files, files.First().FileName)">+@(files.Count - 3)</span>
                                                    }
                                                }
                                                <label class="monday-upload" @onclick:stopPropagation>
                                                    +
                                                    <InputFile OnChange="async e => UploadMultipleFiles(e, row.Id, col.Id)" multiple style="display:none" @onclick:stopPropagation />
                                                </label>
                                            </span>
                                        </td>
                                    }
                                    else if (col.Type == "DocumentUpload")
                                    {
                                        <td class="monday-cell monday-doc-col">
                                            <div class="monday-doc-list">
                                                @{
                                                    var cell = row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
                                                    var files = cell?.Files?.ToList() ?? new List<SalvageFile>();

                                                    var docsToShow = files.Take(2).ToList();
                                                    var docOverflow = files.Count - docsToShow.Count;
                                                }
                                                @foreach (var file in docsToShow)
                                                {
                                                    var baseUrl = "https://towboatustb.com";
                                                    var fileUrl = $"{baseUrl}/salvage_uploads/{file.FileName}";
                                                    var officeViewerUrl = $"https://view.officeapps.live.com/op/view.aspx?src={Uri.EscapeDataString(fileUrl)}";

                                                    <span class="monday-doc">
                                                        @if (file.FileType == "application/pdf")
                                                        {
                                                            <a href="@($"/salvage_uploads/{file.FileName}")" target="_blank">
                                                                <i class="fade fa-file-pdf-o"></i>
                                                                <span class="monday-doc-name" title="@file.OriginalName">@file.OriginalName</span>
                                                            </a>
                                                        }
                                                        else if (file.FileType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
                                                        file.FileType == "application/msword" ||
                                                        file.FileType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" ||
                                                        file.FileType == "application/vnd.openxmlformats-officedocument.presentationml.presentation" ||
                                                        file.FileType == "application/vnd.ms-excel")
                                                        {
                                                            <a href="@officeViewerUrl" target="_blank" rel="noopener">
                                                                <i class="fa fa-file-word-o"></i>
                                                                <span class="monday-doc-name" title="@file.OriginalName">@file.OriginalName</span>
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="@($"/salvage_uploads/{file.FileName}")" target="_blank">
                                                                <i class="fa fa-file-o"></i>
                                                                <span class="monday-doc-name" title="@file.OriginalName">@file.OriginalName</span>
                                                            </a>
                                                        }
                                                        <button class="monday-doc-delete" title="Delete" @onclick="() => DeleteFileAsync(file.Id)">
                                                            <i class="fa fa-trash"></i>
                                                        </button>
                                                    </span>
                                                }
                                                @if (docOverflow > 0)
                                                {
                                                    <span class="monday-more" @onclick="() => OpenDocGallery(files)">+@docOverflow more</span>
                                                }
                                                <label class="monday-upload" @onclick:stopPropagation>
                                                    +
                                                    <InputFile OnChange="e => UploadDocumentFiles(e, row.Id, col.Id)" multiple style="display:none" @onclick:stopPropagation />
                                                </label>
                                            </div>
                                        </td>
                                    }
                                    else if (col.Type == "LongText")
                                    {
                                        var cell = row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
                                        var value = cell?.Value ?? "";

                                        <td class="monday-cell">
                                            <span class="input-tooltip-container">
                                                <input class="form-control" readonly value="@value" @onclick="() => OpenLongTextModal(row, col)" />
                                                @if (!string.IsNullOrWhiteSpace(value) && value.Length > 15)
                                                {
                                                    <span class="input-tooltip">
                                                        <div class="tooltip-content">@value</div>
                                                    </span>
                                                }
                                            </span>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="monday-cell">
                                            <span class="input-tooltip-container">
                                                @RenderCell(row, col)
                                                @{
                                                    var cell = row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
                                                    var value = cell?.Value ?? "";
                                                }
                                                @if (!string.IsNullOrWhiteSpace(value) && value.Length > 15)
                                                {
                                                    <span class="input-tooltip">
                                                        <span>@value</span>
                                                    </span>
                                                }
                                            </span>
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <div class="monday-add-group">
            <button class="monday-add-group-btn" type="button">+ Add new group</button>
        </div>
    </div>

    @if (isGalleryOpen)
    {
        <div class="gallery-modal">
            <div class="main-image">
                <img src="@($"/salvage_uploads/{selectedImage}")" />
            </div>
            <div class="sidebar-thumbs">
                @foreach (var img in currentGallery)
                {
                    <div class="gallery-thumb-container">
                        <img src="@($"/salvage_uploads/{img.FileName}")" class="thumb" @onclick="() => selectedImage = img.FileName" />
                        <button class="delete-gallery-thumb" title="Delete" @onclick="async () => await DeleteFileAsync(img.Id)" @onclick:stopPropagation>
                            ?
                        </button>
                    </div>
                }
            </div>
            <button class="close-btn" @onclick="() => isGalleryOpen = false">×</button>
        </div>
    }

    @if (isLongTextModalOpen)
    {
        <div class="longtext-modal-backdrop"></div>
        <div class="longtext-modal">
            <div class="longtext-modal-dialog">
                <div class="longtext-modal-content">
                    <div class="longtext-modal-header">
                        <h5 class="modal-title">Edit Text</h5>
                        <button type="button" class="close-btn" @onclick="CloseLongTextModal">x</button>
                    </div>
                    <div class="longtext-modal-body">
                        <textarea class="form-control" style="min-height:400px; width:100%;font-size:1.1rem" @bind="editingLongText"></textarea>
                    </div>
                    <div class="longtext-modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseLongTextModal">Cancel</button>
                        <button class="btn btn-primary" @onclick="SaveLongTextModal">Save</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isQuickEntryModalOpen)
    {
        <div class="longtext-modal-backdrop"></div>
        <div class="longtext-modal">
            <div class="longtext-modal-dialog">
                <div class="longtext-modal-content">
                    <div class="longtext-modal-header">
                        <h5 class="modal-title">Quick Entry</h5>
                        <button type="button" class="close-btn" @onclick="CloseQuickEntryModal">x</button>
                    </div>
                    <div class="longtext-modal-body">
                        <textarea class="form-control" style="min-height: 225px; width:100%;font-size:1.05rem" @bind="quickEntryInput"></textarea>
                        <div class="mt-3">
                            <button class="btn btn-secondary" @onclick="ParseQuickEntry">Parse</button>
                        </div>
                        @if (quickEntry != null)
                        {
                            <div class="mt-4 p-3 border rounded" style="background:#f6f7fb">
                                <b>Preview Parsed Fields:</b>
                                <div>Date: <span>@quickEntry.Date</span></div>
                                <div>Dispatch #: <span>@quickEntry.DispatchNumber</span></div>
                                <div>Claim #: <span>@quickEntry.IncidentNumber</span></div>
                                <div>Make: <span>@quickEntry.Make</span></div>
                                <div>Model: <span>@quickEntry.Model</span></div>
                                <div>Length: <span>@quickEntry.Length</span></div>
                                <div>Member: <span>@quickEntry.CustomerNumber</span></div>
                                <div>Customer Name: <span>@quickEntry.CustomerName</span></div>
                                <div>Phone #: <span>@quickEntry.PhoneNumber</span></div>
                            </div>
                            <button class="btn btn-success mt-3" @onclick="ApplyQuickEntryToRow">Apply Parsed Data</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @if (activeMenuColumnId != null && portalMenuPosition != null)
    {
        var col = Columns.FirstOrDefault(c => c.Id == activeMenuColumnId);
        if (col != null)
        {
            <div id="menu-@col.Id" class="column-menu" style="position:fixed; left:@portalMenuPosition.LeftPx; top:@portalMenuPosition.TopPx; z-index:99999;">
                <button class="dropdown-item" @onclick="() => StartRenameColumn(col.Id)">Rename</button>
                <button class="dropdown-item text-danger" @onclick="() => DeleteColumn(col.Id)">Delete</button>
            </div>
        }
    }

    @if (isDocGalleryOpen)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal d-block" tabindex="-1" style="z-index: 1200;">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Documents</h5>
                        <button type="button" class="btn-close" @onclick="CloseDocGallery"></button>
                    </div>
                    <div class="modal-body">
                        @if (docGalleryFiles.Count == 0)
                        {
                            <p>No documents.</p>
                        }
                        else
                        {
                            <ul style="list-style-type:none; padding:0;">
                                @foreach (var file in docGalleryFiles)
                                {
                                    var baseUrl = "https://localhost:5010";
                                    var fileUrl = $"{baseUrl}/salvage_uploads/{file.FileName}";
                                    var officeViewerUrl = $"https://view.officeapps.live.com/op/view.aspx?src={Uri.EscapeDataString(fileUrl)}";

                                    <li style="margin-bottom:12px; display:flex; align-items: center;">
                                        @if (file.FileType == "application/pdf")
                                        {
                                            <a href="@($"/salvage_uploads/{file.FileName}")" target="_blank">
                                                <i class="fade fa-file-pdf-o"></i>
                                                @file.OriginalName
                                            </a>
                                        }
                                        else if (file.FileType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
                                        file.FileType == "application/msword" ||
                                        file.FileType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" ||
                                        file.FileType == "application/vnd.openxmlformats-officedocument.presentationml.presentation" ||
                                        file.FileType == "application/vnd.ms-excel")
                                        {
                                            <a href="@officeViewerUrl" target="_blank" rel="noopener">
                                                <i class="fa fa-file-word-o"></i>
                                                @file.OriginalName
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@($"/salvage_uploads/{file.FileName}")" target="_blank">
                                                <i class="fa fa-file-o"></i>
                                                <span class="doc-filename" title="@file.OriginalName">@file.OriginalName</span>
                                            </a>
                                        }
                                        <button class="delete-doc-btn" title="Delete" @onclick="() => DeleteFileAsync(file.Id)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseDocGallery">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isAddColumnModalOpen)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Add New Column</h5>
                        <button type="button" class="btn-close" @onclick="CloseModal"></button>
                    </div>
                    <div class="modal-body">
                        <label>Column Label</label>
                        <input class="form-control" @bind="newColumnLabel" />

                        <label class="mt-3">Column Type</label>
                        <select class="form-select" @bind="newColumnType">
                            <option value="Text">Text</option>
                            <option value="LongText">Long Text</option>
                            <option value="Status">Status</option>
                            <option value="Dropdown">Dropdown</option>
                            <option value="Date">Date</option>
                            <option value="Number">Number</option>
                            <option value="FileUpload">File Upload</option>
                            <option value="DocumentUpload">Document Upload</option>
                            <option value="Port">Port</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                        <button class="btn btn-primary" @onclick="AddColumn">Add Column</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isRenaming)
    {
        <div class="modal-backdrop fade show"></div>
        <div class="modal d-block" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Rename Column</h5>
                    </div>
                    <div class="modal-body">
                        <input class="form-control" @bind="renameText" />
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" @onclick="() => isRenaming = false">Cancel</button>
                        <button class="btn btn-primary" @onclick="RenameColumn">Save</button>
                    </div>
                </div>
            </div>
        </div>
    }
</AuthorizeView>

