@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using TowBoatSalvageWebApp.Models
@using TowBoatSalvageWebApp.Services
@page "/manage-wo"

@inject ISnackbar Snackbar
@inject WorkOrderService WorkOrderService
@inject IDialogService DialogService
@inject UserService UserService
@using Microsoft.JSInterop
@inject WorkOrderPdfService PdfService
@inject IJSRuntime JS
@inject UserService UserService
@attribute [Authorize]

<PageTitle>Manage Work Orders</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Gutters="false" Class="manage-wo-page pa-4">
    <MudStack Spacing="3">
        <!-- Header -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
            <MudIcon Icon="@Icons.Material.Filled.Assignment" Color="Color.Primary" />
            <MudStack Spacing="0">
                <MudText Typo="Typo.h5" Class="font-weight-bold">Work Order Overview</MudText>
                @* <MudText Typo="Typo.body2" Class="text-muted">Tracking @TotalOrders work orders across the fleet</MudText> *@
            </MudStack>
        </MudStack>

        <!-- Stat cards -->
        <div class="wo-stat-grid">
            <MudPaper Elevation="1" Class="wo-stat-card">
                <div class="wo-stat-icon neutral"><MudIcon Icon="@Icons.Material.Filled.Assignment" /></div>
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@TotalOrders</MudText>
                    <MudText Typo="Typo.body2">Total Orders</MudText>
                </div>
            </MudPaper>

            <MudPaper Elevation="1" Class="wo-stat-card">
                <div class="wo-stat-icon warning"><MudIcon Icon="@Icons.Material.Filled.WarningAmber" /></div>
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@OpenOrders</MudText>
                    <MudText Typo="Typo.body2">Open Orders</MudText>
                </div>
            </MudPaper>

            <MudPaper Elevation="1" Class="wo-stat-card">
                <div class="wo-stat-icon success"><MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" /></div>
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@ResolvedOrders</MudText>
                    <MudText Typo="Typo.body2">Resolved Orders</MudText>
                </div>
            </MudPaper>

            @* <MudPaper Elevation="1" Class="wo-stat-card">
                <div class="wo-stat-icon primary"><MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" /></div>
                <div>
                    <MudText Typo="Typo.h5" Class="font-weight-bold">@FleetVesselCount</MudText>
                    <MudText Typo="Typo.body2">Fleet Vessels</MudText>
                </div>
            </MudPaper> *@
        </div>

        <!-- Filters -->
        <MudPaper Elevation="1" Class="pa-3">
            <div class="wo-filter-row">
                <MudTextField T="string"
                              @bind-Value="_searchText"
                              Placeholder="Search issues..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Class="wo-filter-search" />

                <MudSelect T="string"
                           Label="All Statuses"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           @bind-Value="_statusFilter"
                           Class="wo-filter-select">
                    @foreach (var status in _statusOptions)
                    {
                        <MudSelectItem Value="@status">@status</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string"
                           Label="All Vessels"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           @bind-Value="_vesselFilter"
                           Class="wo-filter-select">
                    @foreach (var vessel in VesselOptions)
                    {
                        <MudSelectItem Value="@vessel">@vessel</MudSelectItem>
                    }
                </MudSelect>

                <MudText Typo="Typo.body2" Class="wo-showing-text">
                    Showing @PagedOrders.Count of @TotalFilteredOrders filtered (@TotalOrders total)
                </MudText>
            </div>
        </MudPaper>

        <!-- Table -->
        <MudPaper Elevation="1" Class="wo-table-wrap">
            @if (_isLoading)
            {
                <div class="pa-6 d-flex justify-center">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (FilteredOrders.Count == 0)
            {
                <div class="pa-6">
                    <MudText Typo="Typo.body1" Align="Align.Center">No work orders match your filters.</MudText>
                </div>
            }
            else
            {
                <table class="wo-table">
                    <thead>
                        <tr>
                            @* <th>ORDER #</th> *@
                            <th>DATE</th>
                            <th>VESSEL</th>
                            <th>ENGINE HRS (1/2)</th>
                            <th>ISSUES</th>
                            <th>STATUS</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in PagedOrders)
                        {
                            <tr>
                                @* <td><span class="wo-order-chip">@GetOrderNumber(order.Id)</span></td> *@
                                <td>@FormatDate(order.RequestDateDisplay)</td>

                                <td class="font-weight-bold">@order.VesselName</td>

                                <td>
                                    @if (_editingRows.Contains(order.Id))
                                    {
                                        <MudTextField T="string" @bind-Value="@GetOrCreateEditModel(order).Engine1Hours" Variant="Variant.Text" Dense="true" />
                                        <span class="engine-sep">|</span>
                                        <MudTextField T="string" @bind-Value="@GetOrCreateEditModel(order).Engine2Hours" Variant="Variant.Text" />

                                    }
                                    else
                                    {
                                        <span class="engine-val"> @order.Engine1Hours</span>
                                        <span class="engine-sep">|</span>
                                        <span class="engine-val"> @order.Engine2Hours</span>
                                    }
                                    
                                </td>

                                <td><span class="wo-issue-count">@order.ReportedIssues.Count</span></td>

                                <td>
                                    <span class="@GetStatusClass(order)">
                                        @GetStatusLabel(order)
                                    </span>
                                </td>

                                <td>
                                    <div class="wo-row-actions">
                                         <MudIconButton Icon="@(_editingRows.Contains(order.Id) ? Icons.Material.Filled.EditOff : Icons.Material.Filled.Edit)"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   AriaLabel="Edit work order"
                                                   OnClick="@(() => ToggleEdit(order))" />

                                        <MudIconButton Icon="@(_expandedRows.Contains(order.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                       Size="Size.Small"
                                                       Color="Color.Default"
                                                       OnClick="@(() => ToggleExpanded(order.Id))" />

                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       Class="wo-delete-btn"
                                                       AriaLabel="Delete work order"
                                                       OnClick="@(() => ConfirmDeleteOrderAsync(order))" />

                                        <MudIconButton Icon="@(order.bHasBeenDownloaded ? @Icons.Material.Filled.DownloadDone : @Icons.Material.Filled.Download)"
                                                       Size="Size.Small"
                                                       Color="Color.Info"
                                                       AriaLabel="Download work order PDF"
                                                       OnClick="@(() => DownloadPdfAsync(order))" />
                                    </div>
                                   
                                </td>
                            </tr>

                            @if (_expandedRows.Contains(order.Id))
                            {
                                <tr class="wo-expanded-row">
                                    <td colspan="7">
                                        @if (_editingRows.Contains(order.Id))
                                        {
                                            var draft = GetOrCreateEditModel(order);

                                            <div class="wo-edit-wrap">
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-1" />
                                                    Edit Work Order
                                                </MudText>

                                                <div class="wo-detail-section mb-3">
                                                    <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Issues &amp;
                                                        Corrections</MudText>

                                                    <div class="issue-correction-list">
                                                        @for (var i = 0; i < draft.ReportedIssues.Count; i++)
                                                        {
                                                            var issueIndex = i;
                                                            var thread = GetCorrentionThread(order, issueIndex);

                                                            <!-- Editable issue text -->
                                                            <div class="wo-edit-issue-row">
                                                                <MudTextField T="string"
                                                                              Value="@draft.ReportedIssues[issueIndex]"
                                                                              ValueChanged="@((string? value) => UpdateIssue(order.Id, issueIndex, value ?? string.Empty))"
                                                                              Placeholder="Describe issue..."
                                                                              Variant="Variant.Outlined"
                                                                              Margin="Margin.Dense"
                                                                              Label="@($"Issue #{issueIndex + 1}")"
                                                                              Class="flex-grow-1" />

                                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                                               Color="Color.Error"
                                                                               Size="Size.Small"
                                                                               AriaLabel="Remove issue"
                                                                               OnClick="@(() => RemoveIssue(order.Id, issueIndex))" />
                                                            </div>

                                                            <!-- Existing corrections (read-only) -->
                                                            @if (thread.Count > 0)
                                                            {
                                                                @foreach (var correction in thread)
                                                                {
                                                                    <MudPaper Elevation="0" Class="correction-box px-3 py-2 mb-1">
                                                                        <div class="d-flex justify-space-between align-center">
                                                                            <MudText Typo="Typo.caption" Class="correction-label">@correction.Author</MudText>
                                                                            <MudText Typo="Typo.caption" Style="color:#8899aa;">
                                                                                @correction.CreatedAtUtc.ToLocalTime().ToString("M/d/yyyy h:mm tt")
                                                                            </MudText>
                                                                        </div>
                                                                        <MudText Typo="Typo.body2">@correction.Text</MudText>
                                                                    </MudPaper>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <MudPaper Elevation="0" Class="correction-box px-3 py-2 mb-1">
                                                                    <MudText Typo="Typo.body2" Class="font-italic" Style="color:#8899aa;">No corrections yet.</MudText>
                                                                </MudPaper>
                                                            }

                                                            <!-- Add correction input -->
                                                            @if (IsAddingCorrectionForIssue(order.Id, issueIndex))
                                                            {
                                                                <MudPaper Elevation="0" Class="correction-box px-3 py-2 mb-3" Style="border-color:#66bb6a;">
                                                                    <MudTextField T="string"
                                                                                  Value="@GetNewCorrectionText(order.Id, issueIndex)"
                                                                                  ValueChanged="@((string? val) => SetNewCorrectionText(order.Id, issueIndex, val ?? string.Empty))"
                                                                                  Placeholder="Describe what was done..."
                                                                                  Lines="2"
                                                                                  Variant="Variant.Filled"
                                                                                  Margin="Margin.Dense"
                                                                                  Class="mb-2" />
                                                                    <div class="d-flex gap-2">
                                                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                                                                   Disabled="@string.IsNullOrWhiteSpace(GetNewCorrectionText(order.Id, issueIndex))"
                                                                                   OnClick="@(() => SubmitCorrectionAsync(order, issueIndex))">
                                                                            Save
                                                                        </MudButton>
                                                                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                                                                   OnClick="@(() => CancelAddingCorrection(order.Id, issueIndex))">
                                                                            Cancel
                                                                        </MudButton>
                                                                    </div>
                                                                </MudPaper>
                                                            }
                                                            else
                                                            {
                                                                <div class="mb-3">
                                                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                                                               StartIcon="@Icons.Material.Filled.AddComment"
                                                                               OnClick="@(() => StartAddingCorrection(order.Id, issueIndex))">
                                                                        Add Correction
                                                                    </MudButton>
                                                                </div>
                                                            }
                                                        }
                                                    </div>

                                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                                               StartIcon="@Icons.Material.Filled.Add"
                                                               OnClick="@(() => AddIssue(order.Id))">
                                                        Add Issue
                                                    </MudButton>
                                                </div>

                                                <!-- Resolve switch -->
                                                <div class="wo-detail-section mb-3">
                                                    <MudSwitch T="bool" Color="Color.Success" Label="Mark as resolved" @bind-Value="draft.IsResolved" />

                                                    @if (!CanResolveOrder(order))
                                                    {
                                                        <MudText Typo="Typo.caption" Style="color:#8899aa;">
                                                            Every issue needs at least one correction before resolving.
                                                        </MudText>
                                                    }
                                                </div>

                                                <div class="wo-edit-actions">
                                                    <MudButton Variant="Variant.Filled"
                                                               Color="Color.Success"
                                                               StartIcon="@Icons.Material.Filled.Save"
                                                               Disabled="@_savingRows.Contains(order.Id)"
                                                               OnClick="@(() => SaveEditAsync(order))">
                                                        Save
                                                    </MudButton>

                                                    <MudButton Variant="Variant.Text"
                                                               Color="Color.Default"
                                                               StartIcon="@Icons.Material.Filled.Close"
                                                               OnClick="@(() => CancelEdit(order.Id))">
                                                        Cancel
                                                    </MudButton>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                                                                        <div class="wo-detail-readonly pa-4">
                                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">
                                                    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Class="mr-1 text-warning" />
                                                    Reported Issues (@order.ReportedIssues.Count)
                                                </MudText>

                                                @if (order.ReportedIssues.Count == 0)
                                                {
                                                    <div class="wo-empty-box">No reported issues.</div>
                                                }
                                                else
                                                {
                                                    <div class="issue-correction-list">
                                                        @for (var i = 0; i < order.ReportedIssues.Count; i++)
                                                        {
                                                            var issueIndex = i;
                                                            var thread = GetCorrentionThread(order, issueIndex);

                                                            <MudPaper Elevation="0" Class="order-issue-item px-3 py-2 mb-1">
                                                                <span class="issue-dot">•</span>
                                                                <MudText Typo="Typo.body1" Class="font-weight-bold">
                                                                    Issue #@(issueIndex + 1): @order.ReportedIssues[issueIndex]
                                                                </MudText>
                                                            </MudPaper>

                                                            @if (thread.Count > 0)
                                                            {
                                                                @foreach (var correction in thread)
                                                                {
                                                                    <MudPaper Elevation="0" Class="correction-box px-3 py-2 mb-1">
                                                                        <div class="d-flex justify-space-between align-center">
                                                                            <MudText Typo="Typo.caption" Class="correction-label">
                                                                                @correction.Author
                                                                            </MudText>
                                                                            <MudText Typo="Typo.caption" Style="color:#8899aa;">
                                                                                @correction.CreatedAtUtc.ToLocalTime().ToString("M/d/yyyy h:mm tt")
                                                                            </MudText>
                                                                        </div>
                                                                        <MudText Typo="Typo.body2">@correction.Text</MudText>
                                                                    </MudPaper>
                                                                }
                                                            }
                                                            else
                                                            {
                                                                <MudPaper Elevation="0" Class="correction-box px-3 py-2 mb-1">
                                                                    <MudText Typo="Typo.body2" Class="font-italic" Style="color:#8899aa;">
                                                                        No corrections yet.
                                                                    </MudText>
                                                                </MudPaper>
                                                            }
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="wo-detail-footer">
                                            <span>Created: @FormatDateTime(order.RequestDateDisplay)</span>
                                            <span class="wo-id-badge">ID: wo-@order.Id</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                @if (TotalFilteredOrders > PageSize)
                {
                    <div class="wo-pagination-wrap">
                        <MudText Typo="Typo.caption" Class="wo-pagination-text">
                            Page @_currentPage of @TotalPages
                        </MudText>

                        <MudPagination Count="@TotalPages"
                                        @bind-Selected="_currentPage"
                                        ShowFirstButton="true"
                                        ShowLastButton="true"
                                        BoundaryCount="1"
                                        Size="Size.Small" />
                    </div>
                }
            }
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
        [Parameter] public bool IsFromAdminDashboard { get; set; }

    private bool _isLoading;
    private string _searchText = string.Empty;
    private string _statusFilter = "All";
    private string _vesselFilter = AllVesselsOption;

    private readonly HashSet<int> _editingRows = new();
    private readonly HashSet<int> _savingRows = new();
    private readonly Dictionary<int, WorkOrderEditModel> _editModels = new();
    private string _editingEngine1Hours = "";
    private string _editingEngine2Hours = "";

    private readonly HashSet<int> _expandedRows = new();

    // correction thread UI state
    private readonly HashSet<(int OrderId, int IssueIndex)> _addingCorrection = new();
    private readonly Dictionary<(int OrderId, int IssueIndex), string> _correctionDrafts = new();

    private const int PageSize = 10;
    private int _currentPage = 1;

    private int TotalFilteredOrders => FilteredOrders.Count;

    private int TotalPages
    {
        get
        {
            var pages = (int)Math.Ceiling(TotalFilteredOrders / (double)PageSize);
            return Math.Max(1, pages);
        }
    }

    private List<WorkOrder> PagedOrders
    {
        get
        {
            if (_currentPage < 1) _currentPage = 1;
            if (_currentPage > TotalPages) _currentPage = TotalPages;

            return FilteredOrders
                .Skip((_currentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
    }

    private readonly List<string> _statusOptions = new()
    {
        "All",
        "Resolved",
        "Unresolved"
    };

    private List<WorkOrder> _allOrders = new();
    private string? selectedBoatFilter = null;
    private List<WorkOrder> FilteredOrders => _allOrders
        .Where(MatchesStatus)
        .Where(MatchesVessel)
        .Where(MatchesSearch)
        .OrderByDescending(x => x.RequestDateDisplay ?? DateTime.MinValue)
        .ToList();

    private int TotalOrders => _allOrders.Count;
    private int OpenOrders => _allOrders.Count(x => !x.IsResolved);
    private int ResolvedOrders => _allOrders.Count(x => x.IsResolved);
    private int FleetVesselCount => _allOrders.Select(x => x.VesselName).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    private List<string> VesselOptions =>
        new[] { AllVesselsOption }
            .Concat(boats
                .Where(x => !string.IsNullOrWhiteSpace(x))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x))
            .ToList();

    private const string AllVesselsOption = "All";

    private List<string> boats = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadOrdersAsync();
    }

    //private async Task LoadWOrk

    private async Task DeleteOrderAsync(WorkOrder order)
    {
        try
        {
            await WorkOrderService.DeleteAsync(order.Id);

            _expandedRows.Remove(order.Id);
            _allOrders.RemoveAll(x => x.Id == order.Id);

            Snackbar.Add($"Deleted work order {GetOrderNumber(order.Id)}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete work order: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadOrdersAsync()
    {
        _isLoading = true;

        try
        {
            boats = await WorkOrderService.GetBoatNamesAsync();
            _allOrders = await WorkOrderService.GetAllAsync();

            // Keep filter valid if data changes
            if (!VesselOptions.Contains(_vesselFilter, StringComparer.OrdinalIgnoreCase))
                _vesselFilter = AllVesselsOption;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Unable to load work orders: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleExpanded(int id)
    {
        if (_expandedRows.Contains(id))
            _expandedRows.Remove(id);
        else
            _expandedRows.Add(id);
    }

    private bool MatchesStatus(WorkOrder order)
    {
        return _statusFilter switch
        {
            "Resolved" => order.IsResolved,
            "Unresolved" => !order.IsResolved,
            _ => true
        };
    }

    private bool MatchesVessel(WorkOrder order)
    {
        if (_vesselFilter == "All")
            return true;

        return string.Equals(order.VesselName, _vesselFilter, StringComparison.OrdinalIgnoreCase);
    }

    private bool MatchesSearch(WorkOrder order)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return true;

        var value = _searchText.Trim();

        return (!string.IsNullOrWhiteSpace(order.VesselName) && order.VesselName.Contains(value, StringComparison.OrdinalIgnoreCase))
               || order.ReportedIssues.Any(i => i.Contains(value, StringComparison.OrdinalIgnoreCase))
               || (!string.IsNullOrWhiteSpace(order.CorrectionNotes) && order.CorrectionNotes.Contains(value, StringComparison.OrdinalIgnoreCase))
               || GetOrderNumber(order.Id).Contains(value, StringComparison.OrdinalIgnoreCase);
    }

    private static string GetOrderNumber(int id) => id.ToString("D4");
    private static string FormatDate(DateTime? date) => date?.ToString("MMM dd, yyyy") ?? "—";
    private static string FormatDateTime(DateTime? date) => date?.ToString("M/d/yyyy, h:mm:ss tt") ?? "—";

    private static string GetStatusLabel(WorkOrder order) => order.IsResolved ? "Resolved" : "Open";
    private static string GetStatusClass(WorkOrder order) => order.IsResolved ? "wo-status resolved" : "wo-status open";

    // correction thread helpers (ported from Maintenance&WorkOrder)
    private List<IssueCorrection> GetCorrentionThread(WorkOrder order, int issueIndex)
    {
        // new data path 
        if (order.IssueCorrectionThreads?.TryGetValue(issueIndex, out var thread) == true && thread.Count > 0) return thread;

        //legacy fallback: show old issue corrections as a single entry 
        if (order.IssueCorrections is not null
            && issueIndex < order.IssueCorrections.Count
            && !string.IsNullOrWhiteSpace(order.IssueCorrections[issueIndex]))
        {
            var legacyAuthor = order.IssueCorrectionsBy is not null && issueIndex < order.IssueCorrectionsBy.Count
                ? order.IssueCorrectionsBy[issueIndex]
                : "Unknown";

            return new List<IssueCorrection>
            {
                new()
                {
                    Author = legacyAuthor,
                    Text = order.IssueCorrections[issueIndex],
                    CreatedAtUtc = order.RequestDateDisplay?.ToUniversalTime() ?? DateTime.UtcNow
                }
            };
        }
        return new();
    }

    private bool IsAddingCorrectionForIssue(int orderId, int issueIndex)
        => _addingCorrection.Contains((orderId, issueIndex));

    private void StartAddingCorrection(int orderId, int issueIndex)
    {
        _addingCorrection.Add((orderId, issueIndex));
        _correctionDrafts[(orderId, issueIndex)] = string.Empty;
    }

    private void CancelAddingCorrection(int orderId, int issueIndex)
    {
        _addingCorrection.Remove((orderId, issueIndex));
        _correctionDrafts.Remove((orderId, issueIndex));
    }

    private string GetNewCorrectionText(int orderId, int issueIndex)
        => _correctionDrafts.TryGetValue((orderId, issueIndex), out var text) ? text : string.Empty;

    private void SetNewCorrectionText(int orderId, int issueIndex, string value)
        => _correctionDrafts[(orderId, issueIndex)] = value;

    private bool CanResolveOrder(WorkOrder order)
    {
        for (var i = 0; i < order.ReportedIssues.Count; i++)
        {
            var thread = GetCorrentionThread(order, i);
            if (thread.Count == 0) return false;
        }
        return order.ReportedIssues.Count > 0;
    }

    private void ToggleEdit(WorkOrder order)
    {
        if (_editingRows.Contains(order.Id))
        {
            CancelEdit(order.Id);
            return;
        }

        StartEdit(order);
    }

    private void StartEdit(WorkOrder order)
    {
        _expandedRows.Add(order.Id);
        _editingRows.Add(order.Id);
        _editModels[order.Id] = CreateEditModel(order);
    }

    private void CancelEdit(int orderId)
    {
        _editingRows.Remove(orderId);
        _editModels.Remove(orderId);
        _savingRows.Remove(orderId);
    }

    private WorkOrderEditModel GetOrCreateEditModel(WorkOrder order)
    {
        if (_editModels.TryGetValue(order.Id, out var model))
            return model;

        model = CreateEditModel(order);
        _editModels[order.Id] = model;
        return model;
    }

    private static WorkOrderEditModel CreateEditModel(WorkOrder order)
    {
        return new WorkOrderEditModel
        {
            ReportedIssues = order.ReportedIssues.Count == 0
                ? new List<string> { string.Empty }
                : order.ReportedIssues.Select(x => x).ToList(),
            CorrectionNotes = order.CorrectionNotes ?? string.Empty,
            IsResolved = order.IsResolved,
            Engine1Hours = order.Engine1Hours ?? string.Empty,
            Engine2Hours = order.Engine2Hours ?? string.Empty
        };
    }

    private void UpdateIssue(int orderId, int index, string value)
    {
        if (!_editModels.TryGetValue(orderId, out var model))
            return;

        if (index < 0 || index >= model.ReportedIssues.Count)
            return;

        model.ReportedIssues[index] = value;
    }

    private void AddIssue(int orderId)
    {
        if (!_editModels.TryGetValue(orderId, out var model))
            return;

        model.ReportedIssues.Add(string.Empty);
    }

    private void RemoveIssue(int orderId, int index)
    {
        if (!_editModels.TryGetValue(orderId, out var model))
            return;

        if (index < 0 || index >= model.ReportedIssues.Count)
            return;

        model.ReportedIssues.RemoveAt(index);

        if (model.ReportedIssues.Count == 0)
            model.ReportedIssues.Add(string.Empty);
    }

    private void UpdateCorrectionNotes(int orderId, string value)
    {
        if (_editModels.TryGetValue(orderId, out var model))
            model.CorrectionNotes = value;
    }

    private void UpdateResolved(int orderId, bool value)
    {
        if (_editModels.TryGetValue(orderId, out var model))
            model.IsResolved = value;
    }

    private async Task SubmitCorrectionAsync(WorkOrder order, int issueIndex)
    {
        var text = GetNewCorrectionText(order.Id, issueIndex);
        if (string.IsNullOrWhiteSpace(text)) return;

        var author = UserService.Name ?? "Unknown";

        await WorkOrderService.AddCorrectionAsync(order.Id, issueIndex, author, text);

        CancelAddingCorrection(order.Id, issueIndex);

        Snackbar.Add($"Correction added to issue ${issueIndex + 1}.", Severity.Success);
        await LoadOrdersAsync();
    }
    private async Task SaveEditAsync(WorkOrder order)
    {
        if (!_editModels.TryGetValue(order.Id, out var draft))
            return;

        var normalizedIssues = draft.ReportedIssues
            .Select(x => x?.Trim() ?? string.Empty)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        //rebuild correction threads to match current issues ONLY!, this removes stale corrections that were attached to deleted issues
        var rebuiltThreads = new Dictionary<int, List<IssueCorrection>>();
        if (order.IssueCorrectionThreads != null)
        {
            //only keep threads whose index still exists in the current issue list, should fix the bug kris mentioned with "issue #9"
            for (int i = 0; i < normalizedIssues.Count; i++)
            {
                if (order.IssueCorrectionThreads.TryGetValue(i, out var thread))
                {
                    rebuiltThreads[i] = thread;
                }
            }
        }

        // clean up legacy issue corrections
        var rebuiltLegacyCorrections = new List<string>();
        var rebuiltLegacyCorrectionsBy = new List<string>();
        for (int i = 0; i < normalizedIssues.Count; i++)
        {
            if (order.IssueCorrections is not null && i < order.IssueCorrections.Count) rebuiltLegacyCorrections.Add(order.IssueCorrections[i]);
            else
                rebuiltLegacyCorrections.Add(string.Empty);

            if (order.IssueCorrectionsBy is not null && i < order.IssueCorrectionsBy.Count) rebuiltLegacyCorrectionsBy.Add(order.IssueCorrectionsBy[i]);
            else
                rebuiltLegacyCorrectionsBy.Add(string.Empty);

        }

        var updated = new WorkOrder
        {
            Id = order.Id,
            VesselName = order.VesselName,
            RequestDateDisplay = order.RequestDateDisplay,
            Engine1Hours = draft.Engine1Hours,
            Engine2Hours = draft.Engine2Hours,
            ReportedIssues = normalizedIssues,
            IssueCorrectionThreads = rebuiltThreads,
            IssueCorrections = rebuiltLegacyCorrections,
            IssueCorrectionsBy = rebuiltLegacyCorrectionsBy,
            IsAddingCorrection = order.IsAddingCorrection,
            CorrectionNotes = draft.CorrectionNotes?.Trim() ?? string.Empty,
            FromCrewMember = order.FromCrewMember,
            IsResolved = draft.IsResolved
        };

        _savingRows.Add(order.Id);

        try
        {
            await WorkOrderService.UpdateAsync(updated);

            await LoadOrdersAsync();

            _editingRows.Remove(order.Id);
            _editModels.Remove(order.Id);
            _expandedRows.Add(order.Id);

            Snackbar.Add($"Updated work order {GetOrderNumber(order.Id)}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update work order: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingRows.Remove(order.Id);
        }
    }

    private async Task ConfirmDeleteOrderAsync(WorkOrder order)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            title: "Delete Work Order",
            markupMessage: (MarkupString)"Are you sure you want to delete this?",
            yesText: "Delete",
            cancelText: "Cancel"
            );

        if (confirm == true)
        {
            await DeleteOrderAsync(order);
        }

    }

    private async Task DownloadPdfAsync(WorkOrder order)
    {
        try
        {
            var pdfBytes = PdfService.BuildPdf(order);
            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"WorkOrder_{order.VesselName}_{order.Id:D4}.pdf";

            await JS.InvokeVoidAsync("pdfViewer.downloadPdf", base64, fileName);

            if (UserService?.User?.Email == "Capt.jfreeman@gmail.com")
            {
                await WorkOrderService.SetHasBeenDownloadedAsync(order);
                await LoadOrdersAsync();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to generate PDF: {ex.Message}", Severity.Error);
        }

    }

    private string? GetHasBeenDownloaded(WorkOrder order)
    {
        return order.bHasBeenDownloaded ? "@Icons.Material.Filled.DownloadDone" : "@Icons.Material.Filled.Download";
    }

    private sealed class WorkOrderEditModel
    {
        public List<string> ReportedIssues { get; set; } = new();
        public string CorrectionNotes { get; set; } = string.Empty;
        public bool IsResolved { get; set; }
        public string Engine1Hours { get; set; } = string.Empty;
        public string Engine2Hours { get; set; } = string.Empty;
    }
}

