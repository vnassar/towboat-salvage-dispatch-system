    [Parameter] public SalvageRow Row { get; set; }
    [Parameter] public List<SalvageColumn> Columns { get; set; } = new();
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnUpload { get; set; }
    [Parameter] public EventCallback OnMarkComplete { get; set; }
    [Parameter] public EventCallback OnMarkInProgress { get; set; }


    [Parameter] public EventCallback OnOpenPhotos { get; set; }
    [Parameter] public EventCallback OnOpenNotes { get; set; }

    [Parameter] public EventCallback<InputFileChangeEventArgs> OnUploadPhoto { get; set; }

    private Task HandleOpenPhotos() =>
        OnOpenPhotos.HasDelegate ? OnOpenPhotos.InvokeAsync(Row) : Task.CompletedTask;

    private Task HandleOpenNotes() =>
        OnOpenNotes.HasDelegate ? OnOpenNotes.InvokeAsync(Row) : Task.CompletedTask;



    private string Status => (GetCellValue("Status") ?? string.Empty).Trim();

    private bool IsCompleted => Status.Contains("Salvage Done", StringComparison.OrdinalIgnoreCase);
    private bool IsInProgress => Status.Contains("In Progress", StringComparison.OrdinalIgnoreCase);
    private bool IsNewOrAssigned =>
        string.IsNullOrEmpty(Status) ||
        Status.Contains("Not Assigned", StringComparison.OrdinalIgnoreCase) ||
        Status.Contains("Assigned", StringComparison.OrdinalIgnoreCase);

    private string _address = string.Empty;

    protected override void OnParametersSet()
    {
        _address = ExtractAddressFromNotes();
        Console.WriteLine($"************************************************************************************************************************Address is: {_address}");
    }
    private string ExtractAddressFromNotes()
    {
        var col = Columns.FirstOrDefault(c => c.Label.Contains("Notes", StringComparison.OrdinalIgnoreCase));
        if (col == null) return string.Empty;

        var cell = Row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
        var notes = cell?.Value ?? string.Empty;
        if (string.IsNullOrWhiteSpace(notes)) return string.Empty;

        var lines = notes
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim());

        foreach (var line in lines)
        {
            Console.WriteLine(line);
            if (line.Contains("Address:", StringComparison.OrdinalIgnoreCase))
            {
                var address = line.Substring("Customer Address:".Length).Trim();
                Console.WriteLine($"Returned *** the *** following correct *** address: {address}");
                return address;
            }
        }
        Console.WriteLine($"Returned *** a blank*** address *** string empty ");
        return string.Empty;
    }

    private string GetGoogleMapsUrl() =>
        string.IsNullOrEmpty(_address)
        ? string.Empty
        : $"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(_address)}";


    private string GetCellValue(string label)
    {
        var col = Columns.FirstOrDefault(c => c.Label.Equals(label, StringComparison.OrdinalIgnoreCase));
        if (col != null)
        {
            var cell = Row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
            if (cell != null)
            {
                return cell.Value ?? "";
            }
        }
        return "";
    }

    private int GetFileCount()
    {
        var col = Columns.FirstOrDefault(c => c.Label == "Images");
        if (col != null)
        {
            var cell = Row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
            if (cell != null)
            {
                var count = cell.Files.Count;
                return count;
            }
        }
        return 0;
    }

    private string GetNotePreview()
    {
        var col = Columns.FirstOrDefault(c => c.Label.Contains("Note", StringComparison.OrdinalIgnoreCase));
        if (col != null)
        {
            var cell = Row.Cells.FirstOrDefault(c => c.ColumnId == col.Id);
            if (cell != null)
            {
                var val = cell.Value ?? "";
                if (val.Length > 20)
                    return val.Substring(0, 20) + "...";
                return val;
            }
        }
        return "";
    }

    private string GetStatusClass()
    {
        var status = GetCellValue("Status").ToLower();
        if (status.Contains("complete")) return "status-completed";
        if (status.Contains("progress")) return "status-inprogress";
        return "status-other";
    }

    private void SetCellValue(string label, string value)
    {
        var col = Columns.FirstOrDefault(c => c.Label.Equals(label, StringComparison.OrdinalIgnoreCase));
        if (col is null) return;

        var cell = Row?.Cells?.FirstOrDefault(c => c.ColumnId == col.Id);
        if (cell is null) return;
        cell.Value = value;
        StateHasChanged();
    }

    private async Task HandleMarkInProgress()
    {
        SetCellValue("Status", "In Progress");
        if (OnMarkInProgress.HasDelegate)
            await OnMarkInProgress.InvokeAsync();

        
    }
    
    private async Task HandleMarkComplete()
    {
        SetCellValue("Status", "Salvage Done");
        if (OnMarkComplete.HasDelegate)
            await OnMarkComplete.InvokeAsync();
    }


}
