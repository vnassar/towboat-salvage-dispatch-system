@*footer*@
@if (IsCompleted)
{
    <div class="sc-complete-banner">
        <svg class="sc-ico" viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.6L4 14l5 5 12-12-1.5-1.4z"/></svg>
            Completed
    </div>
}
else
{
    <div class="sc-actions">
        @if (IsNewOrAssigned)
        {
            <button class="sc-btn sc-btn--amber" @onclick="HandleMarkInProgress">
                <svg viewBox="0 0 24 24"><path d="M5 13h14v-2H5v2z" /></svg>
                Mark In Progress
            </button>
        }
        @if (!IsCompleted)
        {
            <button class="sc-btn sc-btn--green" @onclick="HandleMarkComplete">
                <svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.6L4 14l5 5 12-12-1.5-1.4z" /></svg>
                Mark Complete
            </button>
        }
    </div>
}
</div>




