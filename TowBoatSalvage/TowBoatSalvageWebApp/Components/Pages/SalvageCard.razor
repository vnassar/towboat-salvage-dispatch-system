@* REFACTORING HERE !!!!!*@
<div class="salvage-card">
    @*header: name + status pill on the right*@
    <div class="sc-header">
        <div class="sc-title">@GetCellValue("Name")</div>
            @if (IsCompleted)
            {
                <span class="sc-badge sc-badge--completed">Completed</span>
            }
            else if (IsInProgress)
            {
                <span class="sc-badge sc-badge--progress">In Progress</span>
            }
            else
            {
                <span class="sc-badge sc-badge--new">New</span>
            }
        </div>

@*body*@
<div class="sc-body">
    <div class="sc-line">
        @*phone*@
        <svg class="sc-ico" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6.6 10.8a15.1 15.1 0 006.6 6.6l2.2-2.2a1 1 0 011.1-.24c1.2.48 2.6.74 4 .74a1 1 0 011 1V20a1 1 0 01-1 1C11.85 21 3 12.15 3 1a1 1 0 011-1h3.3a1 1 0 011 1c0 1.38.26 2.73.74 3.95a1 1 0 01-.24 1.1L6.6 10.8z" />
        </svg>
        <a class="sc-link" href="tel:@GetCellValue("Phone Number")">@GetCellValue("Phone Number")</a>
    </div>
    <div class="sc-line">
        @*Add href to google maps here with address as hyperlink *@
        @if (!string.IsNullOrEmpty(_address))
        {
            <svg class="sc-ico" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z" />
            </svg>
            <a class="sc-link" href="@GetGoogleMapsUrl()" target="_blank" rel="noopener noreferrer" title="Open in Google Maps">@_address</a>
        }
    </div>

    <div class="sc-line sc-subtle">
        Vessel: @GetCellValue("Vessel Make"), @GetCellValue("Vessel Length")
    </div>
</div>

