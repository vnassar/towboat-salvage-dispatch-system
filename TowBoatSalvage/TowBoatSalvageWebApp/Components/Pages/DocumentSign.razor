    private async Task GetDocumentInfoAsync()
    {
        var rawToken = Token is null ? null : Uri.UnescapeDataString(Token);
        _request = rawToken is null ? null : await LinkService.GetValidRequestAsync(rawToken);
        _isValidToken = _request is not null;

        //link info
        linkSentAt = _request?.SentAtUtc.ToLocalTime().ToString("g") ?? "";
        linkExpiresAt = _request?.ExpiresAtUtc.ToLocalTime().ToString("g") ?? "";

        //get info
        _customerName = _request?.CustomerName ?? "";
        _gps = _request?.GPS ?? "";
        _length = _request?.VesselLength ?? "";
        _makeModel = _request?.VesselMakeModel ?? "";
        _phoneNumber = _request?.CustomerPhone ?? "";

        _unaccompaniedOrigin = _request?.UnaccompaniedOrigin ?? "";
        _unaccompaniedDestination = _request?.UnaccompaniedDestination ?? "";
        // captain name and captain signature are the same.
        _captainName = _request?.CaptainName ?? "";
        _captainSignature = _request?.CaptainName ?? "";
        _customerEmail = _request?.CustomerEmail ?? "";

        //salvage form + quote for credit card authorization
        _underwriter = _request?.Underwriter ?? "";
        _delivery = _request?.Delivery ?? "";
        _quote = _request?.Quote ?? "";
        _salaveContractDate = _request?.SentAtUtc.ToLocalTime().ToString("g") ?? "";
        _claimNumber = _request?.ClaimNumber ?? "";
        _customerAddress = _request?.CustomerAddress ?? "";
        _vesselName = _request?.VesselName ?? "";
        _salvagePricingModel = _request?.SalvagePricingModel ?? "";

        //set which form to display

        GetFormFromRequest(_request!);
    }

    private void GetFormFromRequest(DocumentSignatureRequest request)
    {
        if (request is not null)
        {
            _formName = request.FormName;

            if (request.FormName.Contains("Ungrounding"))
            {
                formBodyToShow = _ungrounding;
            }

            if (request.FormName.Contains("Hazardous"))
            {
                formBodyToShow = _hazardous;
            }

            if (request.FormName.Contains("Unaccompanied"))
            {
                formBodyToShow = _unAccompanied;
            }

            if (request.FormName.Contains("Mooring"))
            {
                formBodyToShow = _mooring;
                isMooringForm = true;
            }

            if (request.FormName.Contains("Credit"))
            {
                formBodyToShow = _creditCard;
            }
        }

    }

