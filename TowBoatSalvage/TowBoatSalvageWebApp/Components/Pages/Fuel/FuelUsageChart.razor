<MudPaper Class="chart-card" Elevation="0">
    <div class="chart-header">
        <h2>Fuel Usage by Boat</h2>

        <MudSelect T="int" Value="SelectedYear" Dense="true" Variant="Variant.Outlined" Class="year-select">
            <MudSelectItem Value="2026">2026</MudSelectItem>
            <MudSelectItem Value="2025">2025</MudSelectItem>
            <MudSelectItem Value="2024">2024</MudSelectItem>
        </MudSelect>
    </div>

    <div class="chart-area">
        <div class="y-axis">
            <span>1200</span>
            <span>900</span>
            <span>600</span>
            <span>300</span>
            <span>0</span>
        </div>

        <div class="bars-area">
            @foreach (var month in MonthlyData)
            {
                <div class="bar-column">
                    <div class="stacked-bar">
                        @foreach (var segment in month.Segments)
                        {
                            <div class="bar-segment @segment.CssClass"
                                 style="height:@segment.HeightPercent%">
                            </div>
                        }
                    </div>

                    <div class="month-label">@month.Month</div>
                </div>
            }
        </div>
    </div>

    <div class="chart-legend">
        <LegendDot CssClass="sea-hawk" Text="Sea Hawk" />
        <LegendDot CssClass="blue-marlin" Text="Blue Marlin" />
        <LegendDot CssClass="northern-star" Text="Northern Star" />
        <LegendDot CssClass="reef-runner" Text="Reef Runner" />
        <LegendDot CssClass="tide-walker" Text="Tide Walker" />
        <LegendDot CssClass="cape-drifter" Text="Cape Drifter" />
    </div>
</MudPaper>

