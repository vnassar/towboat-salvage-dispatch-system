@page "/fuel"
@using TowBoatSalvageWebApp.Data
@using TowBoatSalvageWebApp.Services
@using static TowBoatSalvageWebApp.Services.FuelLogService
@inject FuelLogService FuelLogService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.False" Class="fuel-page">

    <div class="fuel-header">
         <div>
             <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h1" Class="mb-2">Fuel Usage Summary (@summaryYear)</MudText>
                <MudSelect T="string" Label="Select Year" Variant="Variant.Text" @bind-Value="yearSelected" @bind-Value:after="ChangeSelectedyear" FullWidth="false"
                           FitContent="true" ShrinkLabel>
                    @foreach (var year in years)
                    {
                        <MudSelectItem Value="@year">@year</MudSelectItem>
                    }
                </MudSelect>
             </MudStack>
            
        </div> 
        <p></p>

        <MudButton Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Add"
                   Class="new-entry-button"
                    OnClick="NewEntry">
            New Entry
        </MudButton>
    </div>

    <div class="stat-grid">
        <FuelStatCard Title="Total Fuel YTD"
                      MainValue="@TotalFuelYTD"
                      Unit="gal"
                      SubText=""
                      IsPositive="true"
                      Icon="@Icons.Material.Outlined.LocalDrink" />

        <FuelStatCard Title="Active Boats Logged"
                      MainValue="@TotalActiveBoats"
                      Unit=""
                      SubText="of 16 in fleet"
                      Icon="@Icons.Material.Outlined.DirectionsBoat" />

        <FuelStatCard Title="Entries This Month"
                      MainValue="@TotalEntriesThisMonth"
                      Unit=""
                      SubText="@($"last entry {LastEntryInDays}")"
                      IsPositive="true"
                      Icon="@Icons.Material.Outlined.Assessment" />

        <FuelStatCard Title="Avg Fuel Drop"
                      MainValue="@AverageFuelDrop"
                      Unit="gal"
                      SubText="across all boats"
                      Icon="@Icons.Material.Outlined.Speed" />
    </div>

    <div class="dashboard-grid">
        @* <FuelUsageChart /> *@
        <MudPaper Class="doc-section-component-container">
            <MudChart ChartType="ChartType.StackedBar" ChartSeries="@_series" LegendPosition="@_legendPosition" ChartLabels="@_xAxisLabels" Width="100%" Height="300px" ChartOptions="_axisChartOptions"
                      @bind-SelectedIndex="_index" MatchBoundsToSize="_matchBoundsToSize" />
        </MudPaper>

        <AnnualSummaryCard SummaryYear="summaryYear" @key="annualSummaryKey"/>
    </div>

    <div class="all-fuel-entries">
        <MudPaper Class="mt-4">
            <MudTable @key="tableKey"
                Items="@fuelEntries" 
                Dense="true" Hover="true"
                CanCancelEdit="true" 
                Filter="new Func<FuelLogEntry, bool>(FilterFunc)"
                      @bind-SelectedItem="selectedItem1" 
                      SortLabel="Sort By" CommitEditTooltip="Commit Edit"
                      RowEditPreview="BackupItem" 
                      RowEditCancel="ResetItemToOriginalValues"
                      RowEditCommit="ItemHasBeenCommitted"
                      IsEditRowSwitchingBlocked="@blockSwitch" 
                      ApplyButtonPosition="@applyButtonPosition" 
                      EditButtonPosition="@editButtonPosition" EditTrigger="@editTrigger">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Fuel Log Entries</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="searchString" Immediate="true" Placeholder='Search by boat e.g "towboat 1".. or name e.g "james"' Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                </ToolBarContent>
                <ColGroup>
                    @if (applyButtonPosition.DisplayApplyButtonAtStart() || (editButtonPosition.DisplayEditButtonAtStart() && editTrigger == TableEditTrigger.EditButton))
                    {
                        <col style="width:50px;" /> 
                    }
                    <col style="width:120px;" />@*Date*@
                    <col style="width:15%;" />@*Boat*@
                    <col style="width:15%;" />@*Crew*@
                    <col />                 @*Engine 1 hrs*@
                    <col />                 @*Engine 2 hrs*@
                    <col />                 @*Fuel 1*@
                    <col />                 @*Fuel 2*@
                    <col />                 @*Gas Cans*@
                    <col style="width:50px;"/>                 @*Delete item*@
                    @if (applyButtonPosition.DisplayApplyButtonAtEnd() || (editButtonPosition.DisplayEditButtonAtEnd() && editTrigger == TableEditTrigger.EditButton))
                    {
                        <col style="width:50px;" />
                    }
                </ColGroup>
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<FuelLogEntry, object>(x => x.LogDate)">Date</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<FuelLogEntry, object>(x => x.BoatName)">Boat</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<FuelLogEntry, object>(x => x.CrewMember)">Crew Member</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<FuelLogEntry, object>(x => x.Engine1Hours)">Engine 1 Hrs</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<FuelLogEntry, object>(x => x.Engine2Hours)">Engine 2 Hrs</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<FuelLogEntry, object>(x => x.Fuel1)">Fuel 1 (gal)</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<FuelLogEntry, object>(x => x.Fuel2)">Fuel 2 (gal)</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<FuelLogEntry, object>(x => x.GasCans)">Gas Cans (gal)</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date">@context.LogDate.ToShortDateString()</MudTd>
                    <MudTd DataLabel="Boat">@context.BoatName</MudTd>
                    <MudTd DataLabel="Crew Member">@context.CrewMember</MudTd>
                    <MudTd DataLabel="Engine 1 Hrs">@context.Engine1Hours</MudTd>
                    <MudTd DataLabel="Engine 2 Hrs">@context.Engine2Hours</MudTd>
                    <MudTd DataLabel="Fuel 1 (gal)">@context.Fuel1</MudTd>
                    <MudTd DataLabel="Fuel 2 (gal)">@context.Fuel2</MudTd>
                    <MudTd DataLabel="Gas Cans (gal)">@context.GasCans</MudTd>
                    <MudTd ></MudTd>
                </RowTemplate>
                <RowEditingTemplate>
                    <MudTd DataLabel="Date">
                        <MudDatePicker @bind-Date="editDate" Required />
                    </MudTd>
                    <MudTd DataLabel="Boat">
                        <MudTextField @bind-Value="context.BoatName" Required />
                    </MudTd>
                    <MudTd DataLabel="Crew Member">
                        <MudTextField @bind-Value="context.CrewMember" Required />
                    </MudTd>
                    <MudTd DataLabel="Engine 1 Hrs">
                        <MudNumericField @bind-Value="context.Engine1Hours" Min="0" />
                    </MudTd>
                    <MudTd DataLabel="Engine 2 Hrs">
                        <MudNumericField @bind-Value="context.Engine2Hours" Min="0" />
                    </MudTd>
                    <MudTd DataLabel="Fuel 1 (gal)">
                        <MudNumericField @bind-Value="context.Fuel1" Min="0" />
                    </MudTd>
                    <MudTd DataLabel="Fuel 2 (gal)">
                        <MudNumericField @bind-Value="context.Fuel2" Min="0" />
                    </MudTd>
                    <MudTd DataLabel="Gas Cans (gal)">
                        <MudNumericField @bind-Value="context.GasCans" Min="0" />
                    </MudTd>
                    <MudTd >
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" OnClick="(() => ConfirmDeleteFuelEntryAsync(context.ID))" />
                    </MudTd>
                </RowEditingTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
                <EditButtonContent Context="button">
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit" Class="pa-0" OnClick="@button.ButtonAction" Disabled="@button.ButtonDisabled" />
                </EditButtonContent>
            </MudTable>
        </MudPaper>
    </div>

</MudContainer>

@code {

    private List<BoatFuelSummary> fuelSummary = new();
    private Guid annualSummaryKey = Guid.NewGuid();
    private int summaryYear = DateTime.Today.Year;
    private List<string> fuelBoats = new();
    private string? selectedBoatFilter = null;
    private string boatFilterString = "All Boats";
    private List<FuelLogEntry> fuelEntries = new();

    //Stacked Bar Chart From Mudblzaor documentation
    private int _index = -1; //default value cannot be 0 -> first selectedindex is 0.
    private bool _matchBoundsToSize = true;
    private StackedBarChartOptions _axisChartOptions = new()
    {
        BarWidthRatio = 0.5,
        XAxisTitle = "Months",
        YAxisTitle = "Fuel",
    };

    private Position _legendPosition = Position.Bottom;

    private List<ChartSeries<double>> _series = new List<ChartSeries<double>>();
    private string[] _xAxisLabels = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
    //end

    [Parameter] public List<ChartSeries<double>> ChartSeries { get; set; } = new();

    //inline edit mudblazor documention
    private List<string> editEvents = new();
    private bool dense = false;
    private bool hover = true;
    private bool ronly = false;
    private bool canCancelEdit = false;
    private bool blockSwitch = false;
    private string searchString = "";
    private FuelLogEntry? selectedItem1 = null;
    private TableApplyButtonPosition applyButtonPosition = TableApplyButtonPosition.End;
    private TableEditButtonPosition editButtonPosition = TableEditButtonPosition.End;
    private TableEditTrigger editTrigger = TableEditTrigger.RowClick;
    private IEnumerable<FuelLogEntry> FuelLogEntries = new List<FuelLogEntry>();
    //end
    private DateTime? editDate;
    private FuelLogEntry? backupEntry = null;
    private Guid tableKey = Guid.NewGuid();
    private string? yearSelected = "This year";
    private List<string> years = new List<string>
    {
        "This year",
        "Last year"
    };

    private string TotalFuelYTD = string.Empty;
    private string TotalEntriesThisMonth = string.Empty;
    private string TotalActiveBoats = string.Empty;
    private string LastEntryInDays = string.Empty;
    private string AverageFuelDrop = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        fuelSummary = await FuelLogService.GetFuelSummaryAsync(summaryYear);

        fuelBoats = await FuelLogService.GetBoatNamesAsync();
        //await LoadFuelEntriesAsync();
        fuelEntries = await FuelLogService.GetEntriesAsync(string.Empty, summaryYear);
        //fuelEntries = new();
        await BuildFuelChartDataAsync();
        CalculateDashboardStats();
    }

    private async Task LoadFuelEntriesAsync()
    {
        fuelBoats = await FuelLogService.GetBoatNamesAsync();
        // if (selectedBoatFilter is null)
        // {
        //     fuelEntries = new(); //none
        //     return;
        // }

        fuelEntries = await FuelLogService.GetEntriesAsync(string.Empty, summaryYear);
    }

    private async Task BuildFuelChartDataAsync()
    {
        _series.Clear();

        var entries = await FuelLogService.GetEntriesAsync(string.Empty, summaryYear);
        if (entries is null) return;
        var grouped = entries.GroupBy(f => f.BoatName).ToList();

        foreach (var group in grouped)
        {
            var currentMonth = DateTime.Today.Month;
            var monthlyData = new double[currentMonth];

            foreach (var entry in group)
            {
                int monthIndex = entry.LogDate.Month - 1;
                monthlyData[monthIndex] += (double)(entry.Fuel1 + entry.Fuel2 + entry.GasCans);
            }
            _series.Add(new ChartSeries<double>()
            {
                Name = group.Key,
                Data = monthlyData
            });
        }
    }

    private void BackupItem(object element)
    {
        if (element is FuelLogEntry entry)
        {
            backupEntry = new FuelLogEntry
            {
                ID = entry.ID,
                BoatName = entry.BoatName,
                CrewMember = entry.CrewMember,
                LogDate = entry.LogDate,
                Engine1Hours = entry.Engine1Hours,
                Engine2Hours = entry.Engine2Hours,
                Fuel1 = entry.Fuel1,
                Fuel2 = entry.Fuel2,
                GasCans = entry.GasCans,
                CreatedAtUtc = entry.CreatedAtUtc
            };

            // Sync the date picker bridge field
            editDate = entry.LogDate;
        }
    }

    private async void ItemHasBeenCommitted(object element)
    {
        if (element is FuelLogEntry entry)
        {

            await FuelLogService.UpdateAsync(entry);
            Snackbar.Add($"Entry for {entry.BoatName} updated.", Severity.Success);
        }
    }

    private void ResetItemToOriginalValues(object element)
    {
        if (element is FuelLogEntry entry && backupEntry is not null)
        {
            entry.BoatName = backupEntry.BoatName;
            entry.CrewMember = backupEntry.CrewMember;
            entry.LogDate = backupEntry.LogDate;
            entry.Engine1Hours = backupEntry.Engine1Hours;
            entry.Engine2Hours = backupEntry.Engine2Hours;
            entry.Fuel1 = backupEntry.Fuel1;
            entry.Fuel2 = backupEntry.Fuel2;
            entry.GasCans = backupEntry.GasCans;
        }
    }

    private bool FilterFunc(FuelLogEntry element)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        bool boatMatch = element.BoatName.Equals(searchString, StringComparison.OrdinalIgnoreCase);

        bool crewMatch = element.CrewMember.Contains(searchString, StringComparison.OrdinalIgnoreCase);

        return boatMatch || crewMatch;
    }

    private async Task ConfirmDeleteFuelEntryAsync(int id)
    {

        var confirm = await DialogService.ShowMessageBoxAsync(
            title: "Delete Fuel Entry",
            markupMessage: (MarkupString)"Are you sure you want to delete this fuel entry?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            await FuelLogService.DeleteAsync(id);
            Snackbar.Add("Fuel entry deleted.", Severity.Success);
            await LoadFuelEntriesAsync();

            tableKey = Guid.NewGuid();
            selectedItem1 = null;
        }

        StateHasChanged();
    }
    private async Task ChangeSelectedyear()
    {
        if (yearSelected == "Last year")
        {
            summaryYear = DateTime.Today.Year - 1;
            fuelSummary = await FuelLogService.GetFuelSummaryAsync(summaryYear);
            await LoadFuelEntriesAsync();
        }
        else
        {
            summaryYear = DateTime.Today.Year;
            fuelSummary = await FuelLogService.GetFuelSummaryAsync(summaryYear);
            await LoadFuelEntriesAsync();
        }

        await BuildFuelChartDataAsync();
        annualSummaryKey = Guid.NewGuid();
    }

    private void CalculateDashboardStats()
    {


        try
        {
            var groupedEntries = fuelEntries.GroupBy(f => f.BoatName).ToList();
            TotalActiveBoats = groupedEntries.Count().ToString();
            var yearlyTotal = 0m;
            var totalEntriesThisMonth = 0;
            var allEntries = 0;

            foreach (var group in groupedEntries)
            {
                foreach (var entry in group)
                {
                    yearlyTotal += entry.TotalFuel;
                    if (entry.LogDate.Month == DateTime.Today.Month)
                    {
                        totalEntriesThisMonth++;
                    }
                    allEntries++;
                }
            }
            TotalFuelYTD = yearlyTotal.ToString();
            TotalEntriesThisMonth = totalEntriesThisMonth.ToString();
            AverageFuelDrop = ((int)yearlyTotal / allEntries).ToString();

            //


            var lastEntry = fuelEntries.FirstOrDefault();
            if (lastEntry is not null)
            {
                var daysSinceLastEntry = (int)(DateTime.Today - lastEntry.LogDate).TotalDays;
                LastEntryInDays = daysSinceLastEntry.ToString();

                if (LastEntryInDays == "0") {LastEntryInDays = "today"; return; }
                if (LastEntryInDays == "1") {LastEntryInDays = "1 day ago"; return; }

                LastEntryInDays = daysSinceLastEntry.ToString() + " days ago";

            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Exception: {ex}.");
        }

    }

    private void NewEntry()
    {
        Snackbar.Add("Have not implemented this yet. Navigate to new fuel log page...", Severity.Info);
    }
}
