@page "/Honda500HrService/{Id}"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TowBoatSalvageWebApp.Data
@using TowBoatSalvageWebApp.Models
@using TowBoatSalvageWebApp.Services
@inject Honda500HrService Honda500HrService
@inject UserManager<ApplicationUser> UserManager
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>AMS Vessel Inspection</PageTitle>


<MudContainer MaxWidth="MaxWidth.False" Class="pa-0">

    <TowBoatSalvageWebApp.Components.Pages.NavBar.NavigationBar />

    <MudPaper Elevation="0" Square="true">
        <div class="header">
            <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="d-flex my-1">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Class="mx-5" />
                <MudText Typo="Typo.h5" Class="mx-0">Honda 500HR Service</MudText>
            </MudStack>
        </div>

        <div class="initial-inspection">
            <MudPaper Elevation="2" Class="my-1 pa-4 mx-1">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body1">@_honda.BoatNumber</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body1">@_honda.CompletedBy</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudText Typo="Typo.body1">@_honda.DateCompleted.ToString("d")</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            <MudPaper Elevation="2" Class="my-1 pa-4 mx-1">
                <MudGrid Spacing="2">
                    @if (services != null)
                    {
                        @foreach (var service in services)
                        {
                            <MudItem xs="12" sm="6">
                                <MudCheckBox Label="@service.Description" Color="Color.Primary" UncheckedColor="Color.Default" Value="@service.bServiceCompleted" ValueChanged="@((bool val) => SaveProgressAsync(service, val))"/>
                            </MudItem>
                        }
                    }
                </MudGrid>
            </MudPaper>
        </div>
        

        @* <div class="submit">
            <MudPaper Elevation="0" Class=" d-flex justify-center my-2">
                <MudButton OnClick="StartNew500HrServiceAsync" ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled">Start New 500Hr Service</MudButton>
            </MudPaper>
        </div> *@
    </MudPaper>
</MudContainer>


@code {
    [Parameter] public string? Id {get;set;}

    private Honda500Hr _honda = new();
    
    private List<ServiceDescription>? services;
    protected override async Task OnParametersSetAsync()
    {
        _honda = await Honda500HrService.GetServiceForPdfByIdAsync(int.Parse(Id ?? "0")) ?? new();

        services = _honda.ServiceDescriptions ?? new List<ServiceDescription>();

    }

    private async Task SaveProgressAsync(ServiceDescription service, bool val)
    {
        service.bServiceCompleted = val;

        try
        {
            await Honda500HrService.UpdateServiceDescriptionAsync(_honda);
            
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving progress: {ex.Message}", Severity.Error);
        }
    }


}