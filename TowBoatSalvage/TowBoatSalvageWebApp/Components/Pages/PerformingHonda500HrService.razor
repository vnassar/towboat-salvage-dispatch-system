@page "/Honda500HrService/{Id}"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TowBoatSalvageWebApp.Data
@using TowBoatSalvageWebApp.Models
@using TowBoatSalvageWebApp.Services
@inject Honda500HrService Honda500HrService
@inject UserManager<ApplicationUser> UserManager
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>AMS Vessel Inspection</PageTitle>


<MudContainer MaxWidth="MaxWidth.False" Class="pa-0">

    <TowBoatSalvageWebApp.Components.Pages.NavBar.NavigationBar />

    <MudPaper Elevation="0" Square="true" Class="maintenance-shell mx-auto">
        <!-- Header -->
        <MudPaper Elevation="0" Square="true" Class="maintenance-header px-4 pt-6 pb-2">
            <div class="header-title">
                <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Class="mr-2" />
                <MudText Typo="Typo.h5" Class="header-title-text">Fleet Maintenance</MudText>
            </div>
        </MudPaper>

        <div class="boat-info">
            <MudPaper Elevation="2" Class="open-order-card pa-3 mb-0">
                <div class="d-flex justify-space-between">
                    <div class="d-flex align-start mb-2">
                        <div class="order-boat-icon mr-3">
                            <MudIcon Icon="@Icons.Material.Outlined.DirectionsBoat" />
                        </div>
                        <div>
                            <MudText Typo="Typo.h5" Class="font-weight-bold">@_honda.BoatNumber</MudText>
                            <MudText Typo="Typo.body2" Class="order-date">
                                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="mr-1" />
                                @_honda.DateCompleted
                            </MudText>
                        </div>
                    </div>
                </div>

                <MudPaper Elevation="0" Class="engines-box pa-3 mb-3">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Class="engine-label">ENGINE 1</MudText>
                            <MudText Typo="Typo.h6"><strong>@_honda.EngineHours1</strong> <span
                                class="engine-hrs">hrs</span></MudText>
                            </MudItem>
                            <MudItem xs="6">
                                <MudText Typo="Typo.caption" Class="engine-label">ENGINE 2</MudText>
                                <MudText Typo="Typo.h6"><strong>@_honda.EngineHours2</strong> <span
                                    class="engine-hrs">hrs</span></MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudPaper>
                </div>

                <div class="questions-for-mechanic">
                    <MudPaper Elevation="2" Class="questions-card my-1 pa-4 mx-1">
                        @if (services != null)
                        {
                            @foreach (var service in services)
                            {
                                <MudCheckBox Label="@service.Description" Color="Color.Primary"
                                            UncheckedColor="Color.Default" Value="@service.bServiceCompleted"
                                            ValueChanged="@((bool val) => SaveProgressAsync(service, val))" 
                                            Class=""/>
                                <MudDivider Class="my-3" />
                            }
                        }
                            <!-- Resolve button -->
                        <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true"
                                OnClick="@(() => CompleteHondaService(_honda))">
                            <MudIcon Icon="@Icons.Material.Outlined.CheckCircle" Size="Size.Small" Class="mr-1" />
                            Complete Honda Service
                        </MudButton>
                    </MudPaper>
                </div>
                
    </MudPaper>

    

            <div class="previous-logic">
                <MudPaper Elevation="0" Square="true">
                    <div class="header">
                        <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="d-flex my-1">
                            <MudIcon Icon="@Icons.Material.Filled.DirectionsBoat" Class="mx-5" />
                            <MudText Typo="Typo.h5" Class="mx-0">Honda 500HR Service</MudText>
                        </MudStack>
                    </div>

                    <div class="initial-inspection">
                        <MudPaper Elevation="2" Class="my-1 pa-4 mx-1">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.body1">@_honda.BoatNumber</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.body1">@_honda.CompletedBy</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudText Typo="Typo.body1">@_honda.DateCompleted.ToString("d")</MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                        <MudPaper Elevation="2" Class="my-1 pa-4 mx-1">
                            <MudGrid Spacing="2">
                                @if (services != null)
                                {
                                    @foreach (var service in services)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <MudCheckBox Label="@service.Description" Color="Color.Primary"
                                                         UncheckedColor="Color.Default" Value="@service.bServiceCompleted"
                                                         ValueChanged="@((bool val) => SaveProgressAsync(service, val))" />
                                        </MudItem>
                                    }
                                }
                            </MudGrid>
                        </MudPaper>
                    </div>

        
                    @* <div class="submit">
            <MudPaper Elevation="0" Class=" d-flex justify-center my-2">
                <MudButton OnClick="StartNew500HrServiceAsync" ButtonType="ButtonType.Submit" Color="Color.Primary"
            Variant="Variant.Filled">Start New 500Hr Service</MudButton>
            </MudPaper>
        </div> *@
                </MudPaper>
            </div>

    
        </MudContainer>


@code {
    [Parameter] public string? Id { get; set; }

    private Honda500Hr _honda = new();

    private List<ServiceDescription>? services;
    protected override async Task OnParametersSetAsync()
    {
        _honda = await Honda500HrService.GetServiceForPdfByIdAsync(int.Parse(Id ?? "0")) ?? new();

        services = _honda.ServiceDescriptions ?? new List<ServiceDescription>();

    }

    private async Task SaveProgressAsync(ServiceDescription service, bool val)
    {
        service.bServiceCompleted = val;

        try
        {
            await Honda500HrService.UpdateServiceDescriptionAsync(_honda);

        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving progress: {ex.Message}", Severity.Error);
        }
    }

    private async Task CompleteHondaService(Honda500Hr honda)
    {
        try
        {
            honda.bIsResolved = true;
            await Honda500HrService.UpdateServiceDescriptionAsync(honda);
            Snackbar.Add($"Honda service completed successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error completing Honda service: {ex.Message}", Severity.Error);
        }
    }
}

